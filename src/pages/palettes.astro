---
import Layout from "../layouts/Layout.astro";
import { colorFamilies } from "../data/colors";
import { paletteSets, allPaletteTags } from "../data/palettes";

const allTags = allPaletteTags;
---

<Layout
  title="Color Palettes"
  description="Curated color palette collections for designers and developers. Copy HEX codes, explore combinations, and build your next project."
  tags={["color palettes", "color combinations", "design palettes"]}
>
  <div class="palettes-page">

    <!-- Hero -->
    <section class="palettes-hero mesh-bg">
      <div class="hero-inner">
        <div class="palette-badge animate-fade-in-up">Curated Collections</div>
        <h1 class="hero-title">
          Color <span class="title-gradient">Palettes</span>
        </h1>
        <p class="hero-desc">
          Handpicked combinations for every mood and purpose. Click any swatch to copy its hex code.
        </p>

        <!-- Live palette preview strip -->
        <div class="hero-strip" aria-hidden="true">
          {paletteSets.slice(0, 4).flatMap((p) =>
            p.colors?.map((color) => (
              <div class="strip-swatch" style={`background:${color.hex}`}></div>
            ))
          )}
        </div>
      </div>
    </section>

    <!-- Filter bar -->
    <div class="filter-bar" id="palette-filter-bar">
      <div class="filter-inner">
        <div class="filter-tags" role="group" aria-label="Filter palettes by tag">
          {allTags?.map((tag) => (
            <button
              class={`filter-tag ${tag === "all" ? "filter-tag--active" : ""}`}
              data-tag={tag}
            >
              {tag}
            </button>
          ))}
        </div>
        <span class="palette-count" id="palette-count">{paletteSets.length} palettes</span>
      </div>
    </div>

    <!-- Palette Grid -->
    <section class="palettes-section">
      <div class="palettes-grid" id="palettes-grid">
        {paletteSets?.map((palette) => (
          <a
            href={`/palettes/${palette.id}`}
            class="palette-card"
            data-tags={palette.tags.join(",")}
            data-id={palette.id}
          >
            <!-- Swatch row -->
            <div class="swatch-row">
              {palette.colors?.map((color) => (
                <button
                  class="swatch-btn copy-swatch"
                  style={`background: ${color.hex}`}
                  data-hex={color.hex}
                  aria-label={`Copy ${color.hex}`}
                  title={color.hex}
                >
                  <span class="swatch-tooltip">{color.hex}</span>
                </button>
              ))}
            </div>

            <!-- Card body -->
            <div class="card-body">
              <div class="card-head">
                <h2 class="card-title">{palette.name}</h2>
                <button
                  class="copy-all-btn"
                  data-hexes={palette.colors?.map((c) => c.hex).join(",")}
                  aria-label={`Copy all ${palette.name} hex codes`}
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                  </svg>
                  Copy all
                </button>
              </div>
              <p class="card-desc">{palette.description}</p>

              <!-- Hex codes row -->
              <div class="hex-row">
                {palette.colors?.map((color) => (
                  <button
                    class="hex-chip copy-swatch"
                    data-hex={color.hex}
                    aria-label={`Copy ${color.hex}`}
                  >
                    {color.hex}
                  </button>
                ))}
              </div>

              <!-- Tags -->
              <div class="card-tags">
                {palette.tags?.map((tag) => (
                  <span class="card-tag">{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Empty state -->
      <div id="palettes-empty" class="palettes-empty" style="display:none">
        <p class="empty-title">No palettes match that filter.</p>
        <button class="empty-reset" onclick="resetFilter()">Show all palettes</button>
      </div>

      <!-- CTA -->
       <div class="cta-section">
        <div class="cta-spectrum" aria-hidden="true">
          {
            colorFamilies?.map((c) => (
              <div class="cta-bar" style={`background: ${c.baseHex}`} />
            ))
          }
        </div>
        <div class="cta-content">
          <h2 class="cta-title">Explore individual color families</h2>
          <p class="cta-desc">
            Browse all {colorFamilies.length} color families with complete shade scales from 50 to 950.
          </p>
          <a href="/" class="cta-link">Browse All Colors →</a>
        </div>
      </div>
    </section>

    

  </div>
</Layout>

<!-- Toast notification -->
<div class="toast" id="copy-toast" aria-live="polite">Copied!</div>

<script>
  // ── Copy single hex ──────────────────────────────────────────
  const toast = document.getElementById("copy-toast");

  function showToast(msg = "Copied!") {
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.add("toast--visible");
    clearTimeout((window as any).__toastTimer);
    (window as any).__toastTimer = setTimeout(() => {
      toast.classList.remove("toast--visible");
    }, 1800);
  }

  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  }

  document.querySelectorAll<HTMLElement>(".copy-swatch").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const hex = btn.dataset.hex || "";
      const ok = await copyText(hex);
      if (ok) {
        btn.classList.add("swatch--copied");
        showToast(hex);
        setTimeout(() => btn.classList.remove("swatch--copied"), 1200);
      }
    });
  });

  // ── Copy all hexes ───────────────────────────────────────────
  document.querySelectorAll<HTMLElement>(".copy-all-btn").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const hexes = (btn.dataset.hexes || "").split(",").join(", ");
      const ok = await copyText(hexes);
      if (ok) {
        const orig = btn.innerHTML;
        btn.textContent = "Copied!";
        btn.classList.add("copy-all-btn--copied");
        showToast("All hex codes copied");
        setTimeout(() => {
          btn.innerHTML = orig;
          btn.classList.remove("copy-all-btn--copied");
        }, 1500);
      }
    });
  });

  // ── Tag filter ───────────────────────────────────────────────
  const filterBtns = document.querySelectorAll<HTMLElement>(".filter-tag");
  const cards = document.querySelectorAll<HTMLElement>(".palette-card");
  const countEl = document.getElementById("palette-count");
  const emptyEl = document.getElementById("palettes-empty");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach((b) => b.classList.remove("filter-tag--active"));
      btn.classList.add("filter-tag--active");
      const tag = btn.dataset.tag || "all";
      filterPalettes(tag);
    });
  });

  function filterPalettes(tag: string) {
    let visible = 0;
    cards.forEach((card) => {
      const tags = (card.dataset.tags || "").split(",");
      const show = tag === "all" || tags.includes(tag);
      card.style.display = show ? "" : "none";
      if (show) visible++;
    });
    if (countEl) countEl.textContent = `${visible} palette${visible !== 1 ? "s" : ""}`;
    if (emptyEl) emptyEl.style.display = visible === 0 ? "flex" : "none";
  }

  (window as any).resetFilter = () => {
    filterBtns.forEach((b) => b.classList.remove("filter-tag--active"));
    filterBtns[0]?.classList.add("filter-tag--active");
    filterPalettes("all");
  };
</script>

<style>
  .palettes-page {
    min-height: 100dvh;
  }

  /* ── Hero ──────────────────────────────────────────────────── */
  .palettes-hero {
    padding: 64px 24px 48px;
    text-align: center;
    border-bottom: 1px solid var(--border-subtle);
    overflow: hidden;
  }

  .hero-inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .palette-badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--orange);
    background: color-mix(in srgb, var(--orange) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--orange) 25%, transparent);
    padding: 4px 14px;
    border-radius: 999px;
    margin-bottom: 24px;
    opacity: 0;
  }

  .hero-title {
    font-family: "Caveat", cursive, sans-serif;
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--text-primary);
    margin-bottom: 16px;
  }

  .title-gradient {
    background: linear-gradient(135deg, #f97316 0%, #ec4899 40%, #8b5cf6 80%, #3b82f6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-desc {
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 32px;
  }

  .hero-strip {
    display: flex;
    height: 10px;
    border-radius: 999px;
    overflow: hidden;
    max-width: 480px;
    margin: 0 auto;
    box-shadow: var(--shadow-sm);
  }

  .strip-swatch {
    flex: 1;
  }

  /* ── Filter bar ────────────────────────────────────────────── */
  .filter-bar {
    position: sticky;
    top: 64px;
    z-index: 40;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .filter-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .filter-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .filter-tag {
    padding: 5px 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    border: 1.5px solid var(--border);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    text-transform: capitalize;
    transition: all 0.15s ease;
  }

  .filter-tag:hover {
    border-color: var(--orange);
    color: var(--orange);
  }

  .filter-tag--active {
    background: var(--orange);
    border-color: var(--orange);
    color: var(--white);
  }

  .filter-tag--active:hover {
    color: var(--white);
  }

  .palette-count {
    font-size: 12px;
    color: var(--text-muted);
    white-space: nowrap;
    font-weight: 500;
  }

  /* ── Palettes grid ─────────────────────────────────────────── */
  .palettes-section {
    max-width: 1320px;
    margin: 0 auto;
    padding: 32px 24px 80px;
  }

  .palettes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    margin-bottom: 64px;
  }

  /* ── Palette card ──────────────────────────────────────────── */
  .palette-card {
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    background: var(--white);
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    animation: cardIn 0.4s ease both;
    text-decoration: none;
    display: block;
    color: inherit;
  }

  .palette-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--border);
  }

  @keyframes cardIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Swatch row ────────────────────────────────────────────── */
  .swatch-row {
    display: flex;
    height: 96px;
  }

  .swatch-btn {
    flex: 1;
    border: none;
    cursor: pointer;
    position: relative;
    transition: flex 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
  }

  .swatch-btn:hover {
    flex: 2.5;
  }

  .swatch-btn:hover .swatch-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .swatch-btn.swatch--copied::after {
    content: "✓";
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.25);
    color: var(--white);
    font-size: 18px;
    font-weight: 700;
  }

  .swatch-tooltip {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    background: rgba(0,0,0,0.75);
    color: var(--white);
    font-size: 10px;
    font-family: "DM Mono", monospace;
    padding: 2px 6px;
    border-radius: 4px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  /* ── Card body ─────────────────────────────────────────────── */
  .card-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .card-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .copy-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--light);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 4px 10px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  .copy-all-btn:hover {
    color: var(--orange);
    border-color: var(--orange);
    background: var(--orange-subtle);
  }

  .copy-all-btn--copied {
    color: var(--orange) !important;
    border-color: var(--orange) !important;
  }

  .card-desc {
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-muted);
  }

  /* ── Hex chips ─────────────────────────────────────────────── */
  .hex-row {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }

  .hex-chip {
    font-family: "DM Mono", monospace;
    font-size: 10px;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: 5px;
    padding: 3px 7px;
    cursor: pointer;
    transition: all 0.12s ease;
    letter-spacing: 0.02em;
  }

  .hex-chip:hover {
    background: var(--orange-subtle);
    border-color: var(--orange-light);
    color: var(--orange);
  }

  /* ── Card tags ─────────────────────────────────────────────── */
  .card-tags {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
  }

  .card-tag {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    background: var(--light);
    border: 1px solid var(--border-subtle);
    padding: 2px 8px;
    border-radius: 999px;
    letter-spacing: 0.02em;
    text-transform: capitalize;
  }

  /* ── Empty state ───────────────────────────────────────────── */
  .palettes-empty {
    flex-direction: column;
    align-items: center;
    padding: 80px 24px;
    gap: 12px;
    text-align: center;
  }

  .empty-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .empty-reset {
    padding: 8px 20px;
    background: var(--orange);
    color: var(--white);
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .empty-reset:hover {
    opacity: 0.85;
  }

  /* ── CTA ───────────────────────────────────────────────────── */
  .cta-section {
    border-radius: 24px;
    overflow: hidden;
    background: var(--dark);
  }

  .cta-spectrum {
    display: flex;
    height: 6px;
  }
  .cta-bar {
    flex: 1;
  }

  .cta-content {
    padding: 48px;
    text-align: center;
  }

  .cta-title {
    font-family: "Caveat", cursive, sans-serif;
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: white;
    margin-bottom: 8px;
  }

  .cta-desc {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 28px;
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    padding: 12px 28px;
    background: var(--orange);
    color: white;
    font-weight: 600;
    font-size: 15px;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .cta-link:hover {
    background: var(--orange-hover);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px color-mix(in srgb, var(--orange) 35%, transparent);
  }

  /* ── Toast ─────────────────────────────────────────────────── */
  .toast {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%) translateY(16px);
    background: var(--dark);
    color: var(--white);
    font-family: "DM Mono", monospace;
    font-size: 13px;
    padding: 10px 20px;
    border-radius: 10px;
    box-shadow: var(--shadow-lg);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 9999;
    white-space: nowrap;
  }

  .toast--visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* ── Responsive ────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .palettes-hero {
      padding: 48px 16px 36px;
    }

    .palettes-section {
      padding: 20px 16px 60px;
    }

    .palettes-grid {
      grid-template-columns: 1fr;
    }

    .filter-inner {
      padding: 10px 16px;
    }

    .swatch-row {
      height: 80px;
    }

    .cta-content {
      padding: 32px 20px;
    }
    .cta-title {
      font-size: 24px;
    }
  }
</style>