---
import Layout from "../layouts/Layout.astro";
import ColorCard from "../components/ColorCard.astro";
import { colorFamilies } from "../data/colors";

const totalShades = colorFamilies.reduce((sum, c) => sum + c.shades.length, 0);
const tags = [...new Set(colorFamilies.flatMap((c) => c.tags))];
---

<Layout title="Chromatic — Every Color, Every Shade">
  <!-- Hero -->
  <section class="hero mesh-bg">
    <div class="hero-inner">
      <!-- Floating spectrum orbs -->
      <div class="orb orb-1" aria-hidden="true"></div>
      <div class="orb orb-2" aria-hidden="true"></div>
      <div class="orb orb-3" aria-hidden="true"></div>

      <div class="hero-badge animate-fade-in-up">
        <span class="badge-dot"></span>
        {colorFamilies.length} color families · {totalShades} total shades
      </div>

      <h1 class="hero-title animate-fade-in-up stagger-1">
        Every<br />
        <span class="title-spectrum">Color</span><br />
        Perfectly Shaded
      </h1>

      <p class="hero-desc animate-fade-in-up stagger-2">
        The definitive reference for designers and developers. Explore every
        color family from the lightest tint to the deepest shade — with hex
        codes, RGB, and HSL values at your fingertips.
      </p>

      <!-- Spectrum bar -->
      <div
        class="hero-spectrum animate-fade-in-up stagger-3"
        aria-hidden="true"
      >
        {
          colorFamilies?.map((c) => (
            <a
              href={`/colors/${c.slug}`}
              class="spectrum-chip"
              style={`background: ${c.baseHex}`}
              title={c.name}
            />
          ))
        }
      </div>

      <div class="hero-stats animate-fade-in-up stagger-4">
        <div class="stat">
          <span class="stat-num">{colorFamilies.length}</span>
          <span class="stat-label">Color Families</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat">
          <span class="stat-num">{totalShades}</span>
          <span class="stat-label">Unique Shades</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat">
          <span class="stat-num">3</span>
          <span class="stat-label">Color Formats</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Filter & Search bar -->
  <section class="filter-bar">
    <div class="filter-inner">
      <!-- Search -->
      <div class="search-wrap">
        <svg
          class="search-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"
          ></path>
        </svg>
        <input
          type="text"
          id="color-search"
          class="search-input"
          placeholder="Search colors… (e.g. blue, warm, #3b82f6)"
          autocomplete="off"
        />
      </div>

      <!-- Tag filters -->
      <div class="tag-filters" role="group" aria-label="Filter by tag">
        <button class="tag-filter tag-filter--active" data-tag="all">All</button
        >
        {
          tags?.map((tag) => (
            <button class="tag-filter" data-tag={tag}>
              {tag}
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Color Grid -->
  <section class="colors-section">
    <div class="colors-grid" id="colors-grid">
      {
        colorFamilies?.map((color, i) => (
          <div
            class="grid-item"
            data-name={color.name.toLowerCase()}
            data-tags={color.tags.join(",")}
          >
            <ColorCard color={color} index={i} />
          </div>
        ))
      }
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="empty-state" style="display: none;">
      <div class="empty-icon" aria-hidden="true">
        <svg
          width="48"
          height="48"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          opacity="0.3"
        >
          <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"
          ></path>
        </svg>
      </div>
      <p class="empty-title">No colors found</p>
      <p class="empty-desc">Try a different search term or clear the filter.</p>
      <button onclick="clearFilters()" class="empty-cta">Clear filters</button>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 80px 24px 64px;
  }

  .hero-inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  /* Floating orbs */
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    pointer-events: none;
    z-index: 0;
  }
  .orb-1 {
    width: 300px;
    height: 300px;
    background: color-mix(in srgb, #f97316 20%, transparent);
    top: -80px;
    right: -60px;
    animation: float 6s ease-in-out infinite;
  }
  .orb-2 {
    width: 200px;
    height: 200px;
    background: color-mix(in srgb, #ec4899 15%, transparent);
    bottom: -40px;
    left: -40px;
    animation: float 8s ease-in-out infinite reverse;
  }
  .orb-3 {
    width: 160px;
    height: 160px;
    background: color-mix(in srgb, #3b82f6 12%, transparent);
    top: 40%;
    right: 5%;
    animation: float 5s ease-in-out infinite 1s;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--orange);
    background: color-mix(in srgb, var(--orange) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--orange) 25%, transparent);
    padding: 5px 14px;
    border-radius: 999px;
    margin-bottom: 24px;
    opacity: 0;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background: var(--orange);
    border-radius: 50%;
    animation: badgePulse 2s ease-in-out infinite;
  }

  @keyframes badgePulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(0.8);
    }
  }

  .hero-title {
    font-family: "Syne", sans-serif;
    font-size: clamp(40px, 7vw, 72px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: var(--text-primary);
    margin-bottom: 24px;
    opacity: 0;
  }

  .title-spectrum {
    background: linear-gradient(
      135deg,
      #f97316 0%,
      #ec4899 35%,
      #8b5cf6 60%,
      #3b82f6 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-desc {
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 560px;
    margin: 0 auto 40px;
    opacity: 0;
  }

  .hero-spectrum {
    display: flex;
    gap: 4px;
    justify-content: center;
    margin-bottom: 40px;
    flex-wrap: wrap;
    opacity: 0;
  }

  .spectrum-chip {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: block;
    transition:
      transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.2s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }
  .spectrum-chip:hover {
    transform: translateY(-6px) scale(1.15);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.18);
    z-index: 2;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    opacity: 0;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .stat-num {
    font-family: "Syne", sans-serif;
    font-size: 28px;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.03em;
  }

  .stat-label {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .stat-divider {
    width: 1px;
    height: 32px;
    background: var(--border);
  }

  /* Filter bar */
  .filter-bar {
    position: static;
    border-bottom: 1px solid var(--border-subtle);
    background: color-mix(in srgb, var(--surface) 95%, transparent);
  }

  @media (min-width: 1024px) {
    .filter-bar {
      position: sticky;
      top: 64px;
      z-index: 50;
      backdrop-filter: blur(12px);
    }
  }

  .filter-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .search-wrap {
    position: relative;
    flex: 1;
    min-width: 200px;
    max-width: 320px;
  }

  .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 8px 12px 8px 38px;
    border-radius: 10px;
    border: 1.5px solid var(--border);
    background: var(--surface-card);
    font-size: 14px;
    color: var(--text-primary);
    font-family: "DM Sans", sans-serif;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }
  .search-input:focus {
    outline: none;
    border-color: var(--orange);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--orange) 20%, transparent);
  }

  .tag-filters {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    align-items: center;
  }

  .tag-filter {
    padding: 5px 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.02em;
    border: 1.5px solid var(--border);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: "DM Sans", sans-serif;
    text-transform: capitalize;
  }

  .tag-filter:hover {
    background: var(--surface-hover);
    border-color: var(--orange-light);
    color: var(--orange);
  }

  .tag-filter--active {
    background: var(--orange);
    border-color: var(--orange);
    color: white;
  }

  /* Colors grid */
  .colors-section {
    max-width: 1320px;
    margin: 0 auto;
    padding: 40px 24px 80px;
  }

  .colors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
  }

  .grid-item {
    display: contents;
  }

  /* Empty state */
  .empty-state {
    text-align: center;
    padding: 80px 24px;
    grid-column: 1 / -1;
  }

  .empty-title {
    font-family: "Syne", sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 16px 0 8px;
  }

  .empty-desc {
    color: var(--text-muted);
    font-size: 14px;
    margin-bottom: 24px;
  }

  .empty-cta {
    padding: 9px 20px;
    background: var(--orange);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    font-family: "DM Sans", sans-serif;
    transition: background 0.15s ease;
  }
  .empty-cta:hover {
    background: var(--orange-hover);
  }

  @media (max-width: 640px) {
    .hero {
      padding: 48px 16px 40px;
    }
    .hero-stats {
      gap: 20px;
    }
    .filter-inner {
      padding: 10px 16px;
    }
    .colors-section {
      padding: 24px 16px 60px;
    }
    .colors-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 12px;
    }
  }
</style>

<script>
  const searchInput = document.getElementById(
    "color-search",
  ) as HTMLInputElement;
  const grid = document.getElementById("colors-grid")!;
  const emptyState = document.getElementById("empty-state")!;
  const tagBtns = document.querySelectorAll<HTMLButtonElement>(".tag-filter");
  const items = document.querySelectorAll<HTMLDivElement>(".grid-item");

  let activeTag = "all";
  let searchQuery = "";

  function filterColors() {
    let visible = 0;
    items.forEach((item) => {
      const name = item.dataset.name || "";
      const tags = (item.dataset.tags || "").split(",");
      const matchesSearch =
        !searchQuery || name.includes(searchQuery.toLowerCase());
      const matchesTag = activeTag === "all" || tags.includes(activeTag);
      const show = matchesSearch && matchesTag;
      item.style.display = show ? "" : "none";
      if (show) visible++;
    });
    emptyState.style.display = visible === 0 ? "block" : "none";
    grid.style.display = visible === 0 ? "block" : "";
  }

  searchInput?.addEventListener("input", (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    filterColors();
  });

  tagBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeTag = btn.dataset.tag || "all";
      tagBtns.forEach((b) => b.classList.remove("tag-filter--active"));
      btn.classList.add("tag-filter--active");
      filterColors();
    });
  });

  (window as any).clearFilters = () => {
    searchQuery = "";
    activeTag = "all";
    if (searchInput) searchInput.value = "";
    tagBtns.forEach((b) => b.classList.remove("tag-filter--active"));
    tagBtns[0]?.classList.add("tag-filter--active");
    filterColors();
  };
</script>
