---
import Layout from "../layouts/Layout.astro";
import { colorFamilies } from "../data/colors";

const totalShades = colorFamilies.reduce((sum, c) => sum + c.shades.length, 0);
---

<Layout
  title="About — Colorspedia"
  description="Learn about Colorspedia, the professional color reference tool for designers and developers."
>
  <section class="about-hero mesh-bg">
    <div class="about-inner">
      <div class="about-badge animate-fade-in-up">About Colorspedia</div>
      <h1 class="about-title animate-fade-in-up stagger-1">
        Color, Curated<br />
        <span class="title-accent">for Creators</span>
      </h1>
      <p class="about-lead animate-fade-in-up stagger-2">
        Colorspedia is a professional color reference tool built for designers,
        developers, and anyone who works with color. Explore every color family
        with complete shades, multiple format support, and copy-ready code
        snippets.
      </p>
    </div>
  </section>

  <section class="about-content">
    <div class="content-inner">
      <!-- Stats -->
      <div class="stats-grid animate-fade-in-up">
        <div class="stat-card">
          <div class="stat-num">{colorFamilies.length}</div>
          <div class="stat-label">Color Families</div>
          <div class="stat-desc">
            From reds to neutrals, every major hue represented
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-num">{totalShades}</div>
          <div class="stat-label">Unique Shades</div>
          <div class="stat-desc">
            From lightest tint (50) to deepest dark (950)
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-num">3</div>
          <div class="stat-label">Color Formats</div>
          <div class="stat-desc">HEX, RGB, and HSL — instantly copyable</div>
        </div>
        <div class="stat-card">
          <div class="stat-num">0</div>
          <div class="stat-label">Ads, Ever</div>
          <div class="stat-desc">
            Clean, focused, distraction-free experience
          </div>
        </div>
      </div>

      <!-- Features -->
      <div class="features-section">
        <h2 class="features-title">What Colorspedia Offers</h2>
        <div class="features-grid">
          {
            [
              {
                icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>`,
                title: "Instant Copy",
                desc: "Click any shade to copy its value immediately. No friction, no extra steps.",
              },
              {
                icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
                title: "Multiple Formats",
                desc: "Switch between HEX, RGB, and HSL with a single click. Get exactly what your workflow needs.",
              },
              {
                icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
                title: "Ready-Made Snippets",
                desc: "Copy CSS variables, Tailwind config, and SCSS maps for every color — ready to paste.",
              },
              {
                icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>`,
                title: "Search & Filter",
                desc: "Find any color instantly by name or filter by tone — warm, cool, neutral, and more.",
              },
              {
                icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
                title: "Tailwind-First",
                desc: "Built around the Tailwind CSS color system — the standard palette for modern design.",
              },
              {
                icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>`,
                title: "11 Shades Per Color",
                desc: "Every color comes with 11 calibrated shades from 50 to 950 — enough for any use case.",
              },
            ]?.map((f) => (
              <div class="feature-card">
                <div class="feature-icon" set:html={f.icon} />
                <h3 class="feature-title">{f.title}</h3>
                <p class="feature-desc">{f.desc}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- CTA -->
      <div class="cta-section">
        <div class="cta-spectrum" aria-hidden="true">
          {
            colorFamilies?.map((c) => (
              <div class="cta-bar" style={`background: ${c.baseHex}`} />
            ))
          }
        </div>
        <div class="cta-content">
          <h2 class="cta-title">Ready to explore the spectrum?</h2>
          <p class="cta-desc">
            Dive into {colorFamilies.length} color families and {totalShades} shades.
          </p>
          <a href="/" class="cta-link">Browse All Colors →</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-hero {
    padding: 64px 24px;
    text-align: center;
    border-bottom: 1px solid var(--border-subtle);
  }

  .about-inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .about-badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--orange);
    background: color-mix(in srgb, var(--orange) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--orange) 25%, transparent);
    padding: 4px 14px;
    border-radius: 999px;
    margin-bottom: 24px;
    opacity: 0;
  }

  .about-title {
    font-family: "Syne", sans-serif;
    font-size: clamp(40px, 7vw, 72px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--text-primary);
    margin-bottom: 24px;
    opacity: 0;
  }

  .title-accent {
    background: linear-gradient(135deg, #f97316 0%, #ec4899 60%, #8b5cf6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .about-lead {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-secondary);
    opacity: 0;
  }

  .about-content {
    padding: 64px 0 80px;
  }

  .content-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Stats */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 64px;
    opacity: 0;
    animation: fadeInUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.2s forwards;
  }

  .stat-card {
    padding: 24px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 16px;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .stat-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .stat-num {
    font-family: "Syne", sans-serif;
    font-size: 48px;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--orange);
    line-height: 1;
    margin-bottom: 4px;
  }

  .stat-label {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 6px;
    font-family: "Syne", sans-serif;
  }

  .stat-desc {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Features */
  .features-section {
    margin-bottom: 64px;
  }

  .features-title {
    font-family: "Syne", sans-serif;
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 24px;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }

  .feature-card {
    padding: 24px;
    background: var(--white);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    transition: all 0.2s ease;
  }
  .feature-card:hover {
    border-color: var(--orange-light);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .feature-icon {
    width: 40px;
    height: 40px;
    background: var(--light);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--orange);
    margin-bottom: 14px;
  }

  .feature-title {
    font-family: "Syne", sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 6px;
  }

  .feature-desc {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* CTA */
  .cta-section {
    border-radius: 24px;
    overflow: hidden;
    background: var(--dark);
  }

  .cta-spectrum {
    display: flex;
    height: 6px;
  }
  .cta-bar {
    flex: 1;
  }

  .cta-content {
    padding: 48px;
    text-align: center;
  }

  .cta-title {
    font-family: "Syne", sans-serif;
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: white;
    margin-bottom: 8px;
  }

  .cta-desc {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 28px;
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    padding: 12px 28px;
    background: var(--orange);
    color: white;
    font-weight: 600;
    font-size: 15px;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .cta-link:hover {
    background: var(--orange-hover);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px color-mix(in srgb, var(--orange) 35%, transparent);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .about-hero {
      padding: 48px 16px;
    }
    .content-inner {
      padding: 0 16px;
    }
    .cta-content {
      padding: 32px 20px;
    }
    .cta-title {
      font-size: 24px;
    }
  }
</style>
