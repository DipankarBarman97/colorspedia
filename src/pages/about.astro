---
import Layout from "../layouts/Layout.astro";
import { colorFamilies } from "../data/colors";
import { paletteSets, allPaletteTags } from "../data/palettes";

const totalShades = colorFamilies.reduce((sum, c) => sum + c.shades.length, 0);
const totalMoods = allPaletteTags.length - 1; // exclude "all"
---

<Layout
  title="About — Colorspedia"
  description="Learn about Colorspedia, the professional color reference tool for designers and developers."
>
  <section class="about-hero mesh-bg">
    <div class="about-inner">
      <div class="about-badge animate-fade-in-up">About Colorspedia</div>
      <h1 class="about-title animate-fade-in-up stagger-1">
        Color, Curated<br />
        <span class="title-accent">for Creators</span>
      </h1>
      <p class="about-lead animate-fade-in-up stagger-2">
        Colorspedia is a professional color reference tool built for designers,
        developers, and anyone who works with color. Explore every color family
        with complete shades, browse curated palettes for every mood and
        project, and grab copy-ready code snippets in HEX, RGB, or HSL —
        instantly.
      </p>
      <div class="hero-strip" aria-hidden="true">
        {
          paletteSets
            .slice(0, 4)
            .flatMap((p) =>
              p.colors?.map((color) => (
                <div class="strip-swatch" style={`background:${color.hex}`} />
              )),
            )
        }
      </div>
    </div>
  </section>

  <section class="about-content">
    <div class="content-inner">
      <!-- Stats -->
      <div class="stats-grid animate-fade-in-up">
        <div class="stat-card">
          <div class="stat-num">{colorFamilies.length}</div>
          <div class="stat-label">Color Families</div>
          <div class="stat-desc">
            From reds to neutrals, every major hue represented
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-num">{totalShades}</div>
          <div class="stat-label">Unique Shades</div>
          <div class="stat-desc">
            From lightest tint to deepest dark, fully graded
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-num">{paletteSets.length}</div>
          <div class="stat-label">Curated Palettes</div>
          <div class="stat-desc">
            Handpicked combinations across {totalMoods} moods and styles
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-num">0</div>
          <div class="stat-label">Ads, Ever</div>
          <div class="stat-desc">
            Clean, focused, distraction-free experience
          </div>
        </div>
      </div>

      <!-- Features -->
      <div class="features-section">
        <h2 class="features-title">What Colorspedia Offers</h2>
        <div class="features-grid">
          {
            [
              {
                icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>`,
                title: "Instant Copy",
                desc: "Click any shade or palette swatch to copy its value immediately. No friction, no extra steps.",
              },
              {
                icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
                title: "Multiple Formats",
                desc: "Switch between HEX, RGB, and HSL with a single click. Get exactly what your workflow needs.",
              },
              {
                icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
                title: "Ready-Made Snippets",
                desc: "Copy CSS variables, Tailwind config, and SCSS maps for every color family — ready to paste.",
              },
              {
                icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h5m10 0h5M12 2v5m0 10v5M4.93 4.93l3.54 3.54m7.07 7.07 3.54 3.54M4.93 19.07l3.54-3.54m7.07-7.07 3.54-3.54"/></svg>`,
                title: "Curated Palettes",
                desc: `${paletteSets.length} handpicked multi-color combinations across ${totalMoods} moods — from Sunset to Cyberpunk to Monochrome.`,
              },
              {
                icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>`,
                title: "Search & Filter",
                desc: "Find any color instantly by name, or filter palettes by mood — warm, cool, earthy, vivid, and more.",
              },
              {
                icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
                title: "Developer-Ready",
                desc: "CSS variables, Tailwind config, and SCSS maps for every color family. Built for real workflows.",
              },
            ]?.map((f) => (
              <div class="feature-card">
                <div class="feature-icon" set:html={f.icon} />
                <h3 class="feature-title">{f.title}</h3>
                <p class="feature-desc">{f.desc}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- CTA -->
      <div class="cta-section">
        <div class="cta-spectrum" aria-hidden="true">
          {
            colorFamilies?.map((c) => (
              <div class="cta-bar" style={`background: ${c.baseHex}`} />
            ))
          }
        </div>
        <div class="cta-content">
          <h2 class="cta-title">Ready to explore the spectrum?</h2>
          <p class="cta-desc">
            {colorFamilies.length} color families, {totalShades} shades, and {
              paletteSets.length
            } curated palettes — all free.
          </p>
          <div class="cta-actions">
            <a href="/" class="cta-link">Browse Colors →</a>
            <a href="/palettes" class="cta-link cta-link--ghost"
              >View Palettes →</a
            >
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-hero {
    padding: 64px 24px;
    text-align: center;
    border-bottom: 1px solid var(--border-subtle);
  }

  .about-inner {
    max-width: 880px;
    margin: 0 auto;
  }

  .about-badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--orange);
    background: color-mix(in srgb, var(--orange) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--orange) 25%, transparent);
    padding: 4px 14px;
    border-radius: 999px;
    margin-bottom: 24px;
    opacity: 0;
  }

  .about-title {
    font-family: "Caveat", cursive, sans-serif;
    font-size: clamp(40px, 7vw, 72px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--text-primary);
    margin-bottom: 24px;
    opacity: 0;
  }

  .title-accent {
    background: linear-gradient(135deg, #f97316 0%, #ec4899 60%, #8b5cf6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .about-lead {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-secondary);
    opacity: 0;
    margin-bottom: 32px;
  }

  .hero-strip {
    display: flex;
    height: 10px;
    border-radius: 999px;
    overflow: hidden;
    max-width: 480px;
    margin: 0 auto;
    box-shadow: var(--shadow-sm);
  }

  .strip-swatch {
    flex: 1;
  }

  .about-content {
    padding: 64px 0 80px;
  }

  .content-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Stats */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 64px;
    opacity: 0;
    animation: fadeInUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.2s forwards;
  }

  .stat-card {
    padding: 24px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 16px;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .stat-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .stat-num {
    font-family: "Caveat", cursive, sans-serif;
    font-size: 48px;
    font-weight: 800;
    color: var(--orange);
    line-height: 1;
    margin-bottom: 4px;
  }

  .stat-label {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 6px;
  }

  .stat-desc {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Features */
  .features-section {
    margin-bottom: 64px;
  }

  .features-title {
    font-family: "Caveat", cursive, sans-serif;
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin-bottom: 24px;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }

  .feature-card {
    padding: 24px;
    background: var(--white);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    transition: all 0.2s ease;
  }
  .feature-card:hover {
    border-color: var(--orange-light);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .feature-icon {
    width: 40px;
    height: 40px;
    background: var(--light);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--orange);
    margin-bottom: 14px;
  }

  .feature-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 6px;
  }

  .feature-desc {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .about-hero {
      padding: 48px 16px;
    }
    .content-inner {
      padding: 0 16px;
    }
  }
</style>
