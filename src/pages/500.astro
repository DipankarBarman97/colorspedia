---
// src/pages/500.astro
// Astro renders this automatically on unhandled server errors (SSR mode).
// In static mode, you can link to it manually from a global error boundary.
import Layout from "../layouts/Layout.astro";

const pulses = [
  "#ef4444", "#f97316", "#eab308",
  "#22c55e", "#3b82f6", "#a855f7",
];
---

<Layout
  title="500 — Something Went Wrong"
  description="An unexpected error occurred. We're looking into it."
  noindex={true}
>
  <div class="page-500">

    <!-- Radial pulse rings -->
    <div class="pulse-bg" aria-hidden="true">
      {[1, 2, 3].map((i) => (
        <span class="ring" style={`--i: ${i}`}></span>
      ))}
    </div>

    <div class="content">

      <!-- Icon -->
      <div class="error-icon" aria-hidden="true">
        <div class="icon-ring">
          <div class="icon-dots">
            {pulses.map((color, i) => (
              <span
                class="icon-dot"
                style={`background: ${color}; --i: ${i}`}
              ></span>
            ))}
          </div>
        </div>
        <div class="crack" aria-hidden="true"></div>
      </div>

      <!-- Code badge -->
      <div class="code-badge">500</div>

      <h1 class="title">Something went wrong</h1>
      <p class="subtitle">
        An unexpected error occurred on our end. The page couldn't load — but your colors aren't going anywhere.
      </p>

      <!-- Actions -->
      <div class="actions">
        <button class="btn-primary" onclick="window.location.reload()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.5"/>
          </svg>
          Try again
        </button>
        <a href="/" class="btn-ghost">Go home</a>
      </div>

      <!-- Status strip -->
      <div class="status-strip">
        <span class="status-dot"></span>
        <span class="status-text">If this keeps happening, the issue is on our side — please check back shortly.</span>
      </div>

    </div>
  </div>
</Layout>

<style>
  .page-500 {
    min-height: calc(100vh - 130px);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: 48px 24px;
  }

  /* Pulse rings */
  .pulse-bg {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid var(--border-subtle);
    width: calc(var(--i) * 220px);
    height: calc(var(--i) * 220px);
    opacity: 0;
    animation: pulseRing 3.5s ease-out infinite;
    animation-delay: calc(var(--i) * 0.9s);
  }

  @keyframes pulseRing {
    0%   { transform: scale(0.6); opacity: 0.5; }
    100% { transform: scale(1.4); opacity: 0; }
  }

  /* Content */
  .content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 480px;
    width: 100%;
  }

  /* Error icon */
  .error-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    position: relative;
  }

  .icon-ring {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    border: 2px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    box-shadow: 0 4px 24px rgba(0,0,0,0.07);
    position: relative;
    overflow: hidden;
  }

  .icon-dots {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 5px;
    padding: 12px;
  }

  .icon-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    display: block;
    opacity: 0.35;
    animation: flicker 2s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.25s);
  }

  @keyframes flicker {
    0%, 100% { opacity: 0.35; }
    50%       { opacity: 0.9; }
  }

  /* Code badge */
  .code-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ef4444;
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.2);
    border-radius: 6px;
    padding: 3px 10px;
    margin-bottom: 16px;
  }

  /* Text */
  .title {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 12px;
  }

  .subtitle {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 32px;
  }

  /* Buttons */
  .actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 24px;
    background: var(--orange);
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.15s, transform 0.15s;
  }
  .btn-primary:hover {
    opacity: 0.88;
    transform: translateY(-1px);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 10px 24px;
    background: transparent;
    color: var(--text-secondary);
    font-size: 14px;
    font-weight: 500;
    border-radius: 8px;
    border: 1px solid var(--border-subtle);
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s, transform 0.15s;
  }
  .btn-ghost:hover {
    color: var(--orange);
    border-color: var(--orange);
    transform: translateY(-1px);
  }

  /* Status strip */
  .status-strip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: 99px;
    padding: 6px 14px;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ef4444;
    flex-shrink: 0;
    animation: blink 1.4s ease-in-out infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.25; }
  }

  .status-text {
    line-height: 1.4;
    text-align: left;
  }
</style>
