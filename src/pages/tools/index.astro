---
import Layout from "../../layouts/Layout.astro";
import { colorFamilies } from "../../data/colors";
import { paletteSets } from "../../data/palettes";

const tools = [
  {
    href: "/tools/color-converter",
    label: "Color Converter",
    desc: "Convert any color between HEX, RGB, HSL, and HSB instantly.",
    // Two offset color chips connected by bidirectional swap arrows
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
  <rect x="2"  y="3"  width="9" height="8" rx="1.5" fill="color-mix(in srgb, currentColor 12%, transparent)"/>
  <rect x="13" y="13" width="9" height="8" rx="1.5" fill="color-mix(in srgb, currentColor 12%, transparent)"/>
  <path d="M11 7h2.5"/>
  <path d="M11 7l1.5-1.5"/>
  <path d="M11 7l1.5 1.5"/>
  <path d="M13 17h-2.5"/>
  <path d="M13 17l-1.5-1.5"/>
  <path d="M13 17l-1.5 1.5"/>
  <line x1="12" y1="7"  x2="12" y2="11" stroke-dasharray="1.5 1.5"/>
  <line x1="12" y1="13" x2="12" y2="17" stroke-dasharray="1.5 1.5"/>
</svg>`,
    accent: "#3b82f6",
    tags: ["convert", "hex", "rgb", "hsl"],
  },
  {
    href: "/tools/contrast-checker",
    label: "Contrast Checker",
    desc: "Check WCAG AA and AAA compliance for any foreground and background color pair.",
    // Rectangle split: dark top half with white "A", light bottom half with dark "A"
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none">
  <rect x="2" y="3" width="20" height="18" rx="2.5" fill="var(--dark)"/>
  <path d="M2 12.5h20" stroke="var(--border)" stroke-width="0.75"/>
  <path d="M2 12.5h20v5.5a2.5 2.5 0 0 1-2.5 2.5H4.5A2.5 2.5 0 0 1 2 18V12.5z" fill="var(--white)"/>
  <text x="12" y="10"   text-anchor="middle" dominant-baseline="middle" font-size="8.5" font-weight="800" fill="var(--white)"  stroke="none" font-family="system-ui,sans-serif">A</text>
  <text x="12" y="17.5" text-anchor="middle" dominant-baseline="middle" font-size="8.5" font-weight="800" fill="var(--dark)"  stroke="none" font-family="system-ui,sans-serif">A</text>
  <rect x="2" y="3" width="20" height="18" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.5"/>
</svg>`,
    accent: "#10b981",
    tags: ["accessibility", "wcag", "a11y"],
  },
  {
    href: "/tools/palette-generator",
    label: "Palette Generator",
    desc: "Generate harmonious color palettes from a single seed color.",
    // Classic painter's palette silhouette with four paint dots
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
  <path d="M12 2C6.48 2 2 6.48 2 12c0 2.76 1.64 4.25 3.75 4.25 1.1 0 1.75.65 1.75 1.75 0 1.66 1.09 3 2.5 3 5.52 0 10-4.48 10-9S17.52 2 12 2z"/>
  <circle cx="8"    cy="9.5" r="1.4" fill="var(--orange)"       stroke="none"/>
  <circle cx="12"   cy="7"   r="1.4" fill="var(--orange-hover)" stroke="none"/>
  <circle cx="16"   cy="9.5" r="1.4" fill="var(--text-muted)"   stroke="none"/>
  <circle cx="15.5" cy="14"  r="1.4" fill="var(--orange-light)"  stroke="none"/>
</svg>`,
    accent: "#ec4899",
    tags: ["palette", "harmony", "generate"],
  },
  {
    href: "/tools/tint-shade-generator",
    label: "Tint & Shade Generator",
    desc: "Build a full 50–950 shade scale from any base color, ready for Tailwind or CSS.",
    // Five horizontal bars stepping from lightest to fully opaque brand orange
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none">
  <rect x="2" y="3"    width="20" height="3" rx="1" fill="color-mix(in srgb, var(--orange) 15%, transparent)"/>
  <rect x="2" y="7.5"  width="20" height="3" rx="1" fill="color-mix(in srgb, var(--orange) 35%, transparent)"/>
  <rect x="2" y="12"   width="20" height="3" rx="1" fill="color-mix(in srgb, var(--orange) 58%, transparent)"/>
  <rect x="2" y="16.5" width="20" height="3" rx="1" fill="color-mix(in srgb, var(--orange) 78%, transparent)"/>
  <rect x="2" y="21"   width="20" height="1.5" rx="1" fill="var(--orange)"/>
</svg>`,
    accent: "#f97316",
    tags: ["tint", "shade", "scale", "tailwind"],
  },
  {
    href: "/tools/gradient-generator",
    label: "Gradient Generator",
    desc: "Create and export beautiful CSS linear and radial gradients with live preview.",
    // Filled rect with a real orange→hover gradient + subtle stop markers
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none">
  <defs>
    <linearGradient id="gg" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%"   stop-color="var(--orange)"/>
      <stop offset="100%" stop-color="var(--text-secondary)"/>
    </linearGradient>
  </defs>
  <rect x="2" y="6" width="20" height="12" rx="2.5" fill="url(#gg)"/>
  <rect x="2" y="6" width="20" height="12" rx="2.5" fill="none" stroke="var(--orange-hover)" stroke-width="1.5"/>
  <line x1="7"  y1="6" x2="7"  y2="18" stroke="var(--white)" stroke-width="0.75" stroke-opacity="0.3"/>
  <line x1="12" y1="6" x2="12" y2="18" stroke="var(--white)" stroke-width="0.75" stroke-opacity="0.3"/>
  <line x1="17" y1="6" x2="17" y2="18" stroke="var(--white)" stroke-width="0.75" stroke-opacity="0.3"/>
  <circle cx="2"  cy="12" r="2" fill="var(--orange)"         stroke="var(--white)" stroke-width="1"/>
  <circle cx="22" cy="12" r="2" fill="var(--text-secondary)" stroke="var(--white)" stroke-width="1"/>
</svg>`,
    accent: "#8b5cf6",
    tags: ["gradient", "css", "linear", "radial"],
  },
  {
    href: "/tools/color-from-image",
    label: "Color from Image",
    desc: "Upload any image and extract its dominant colors as a ready-to-use palette.",
    // Photo frame with landscape; three extracted color dots below with stems
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
  <rect x="2" y="2" width="20" height="14" rx="2"/>
  <circle cx="7" cy="7" r="1.5" fill="color-mix(in srgb, var(--orange) 70%, transparent)" stroke="var(--orange)" stroke-width="1"/>
  <path d="M2 12l5-4 4 4 3-2.5 8 4.5"/>
  <line x1="6"  y1="16" x2="6"  y2="18.5" stroke-width="1.2"/>
  <line x1="12" y1="16" x2="12" y2="18.5" stroke-width="1.2"/>
  <line x1="18" y1="16" x2="18" y2="18.5" stroke-width="1.2"/>
  <circle cx="6"  cy="20.5" r="1.8" fill="var(--orange)"       stroke="var(--white)" stroke-width="1.2"/>
  <circle cx="12" cy="20.5" r="1.8" fill="var(--text-muted)"   stroke="var(--white)" stroke-width="1.2"/>
  <circle cx="18" cy="20.5" r="1.8" fill="var(--orange-hover)" stroke="var(--white)" stroke-width="1.2"/>
</svg>`,
    accent: "#06b6d4",
    tags: ["image", "extract", "dominant"],
  },
  {
    href: "/tools/color-mixer",
    label: "Color Mixer",
    desc: "Blend two colors together and preview the result across a range of mix ratios.",
    // Two teardrops (orange + muted) overlapping with a blended color in the center
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
  <path d="M8.5 3.5C8.5 3.5 4 8 4 12.5a4.5 4.5 0 0 0 9 0C13 8 8.5 3.5 8.5 3.5z"
    fill="color-mix(in srgb, var(--orange) 45%, transparent)"
    stroke="var(--orange)" stroke-width="1.5"/>
  <path d="M15.5 3.5C15.5 3.5 11 8 11 12.5a4.5 4.5 0 0 0 9 0C20 8 15.5 3.5 15.5 3.5z"
    fill="color-mix(in srgb, var(--text-secondary) 45%, transparent)"
    stroke="var(--text-secondary)" stroke-width="1.5"/>
  <path d="M13 8.5c1 1.5 1.5 2.8 1.5 4a1.5 1.5 0 0 1-3 0c0-1.2.5-2.5 1.5-4z"
    fill="color-mix(in srgb, var(--orange-hover) 85%, transparent)" stroke="none"/>
</svg>`,
    accent: "#f59e0b",
    tags: ["mix", "blend", "combine"],
  },
  {
    href: "/tools/color-blindness-simulator",
    label: "Color Blindness Simulator",
    desc: "Preview how your palette looks under deuteranopia, protanopia, and tritanopia.",
    // Eye shape; iris filled with an orange→muted spectrum gradient, realistic pupil
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
  <defs>
    <linearGradient id="iris" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%"   stop-color="var(--orange)"/>
      <stop offset="40%"  stop-color="var(--orange-hover)"/>
      <stop offset="100%" stop-color="var(--text-secondary)"/>
    </linearGradient>
    <clipPath id="eye-clip">
      <path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"/>
    </clipPath>
  </defs>
  <path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"
    fill="var(--white)" stroke="currentColor" stroke-width="1.75"/>
  <circle cx="12" cy="12" r="4.5"
    fill="url(#iris)" clip-path="url(#eye-clip)"/>
  <circle cx="12" cy="12" r="4.5"
    fill="none" stroke="color-mix(in srgb, currentColor 15%, transparent)" stroke-width="1"/>
  <circle cx="12" cy="12" r="2"
    fill="var(--dark)" stroke="none"/>
  <circle cx="13.2" cy="10.8" r="0.7"
    fill="var(--white)" stroke="none"/>
</svg>`,
    accent: "#64748b",
    tags: ["accessibility", "vision", "simulate"],
  },
];
---

<Layout
  title="Color Tools"
  description="Free color tools for designers and developers — convert, check contrast, generate palettes, and more."
  tags={[
    "color tools",
    "color converter",
    "contrast checker",
    "palette generator",
  ]}
>
  <div class="tools-page">
    <!-- Hero -->
    <section class="tools-hero mesh-bg">
      <div class="hero-inner">
        <div class="tools-badge animate-fade-in-up">
          Designer &amp; Developer Tools
        </div>
        <h1 class="hero-title animate-fade-in-up stagger-1">
          Color <span class="title-accent">Tools</span>
        </h1>
        <p class="hero-desc animate-fade-in-up stagger-2">
          Everything you need to work with color — convert formats, check
          accessibility, build palettes, and export code-ready values.
        </p>

        <div class="hero-strip animate-fade-in-up stagger-3" aria-hidden="true">
          {
            paletteSets
              .slice(0, 4)
              .flatMap((p) =>
                p.colors?.map((color) => (
                  <div class="strip-swatch" style={`background:${color.hex}`} />
                )),
              )
          }
        </div>

        <div class="hero-stats animate-fade-in-up stagger-4">
          <div class="hero-stat">
            <span class="hero-stat-num">{tools.length}</span>
            <span class="hero-stat-label">Tools</span>
          </div>
          <div class="hero-stat-divider" aria-hidden="true"></div>
          <div class="hero-stat">
            <span class="hero-stat-num">Free</span>
            <span class="hero-stat-label">Always</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Tools Grid -->
    <section class="tools-section">
      <div class="tools-inner">
        <div class="section-header">
          <h2 class="section-title">All Tools</h2>
          <p class="section-sub">Click any tool to open it.</p>
        </div>

        <div class="tools-grid">
          {
            tools?.map((tool, i) => (
              <a
                href={tool.href}
                class="tool-card animate-fade-in-up"
                style={`animation-delay: ${i * 0.05}s; --accent: ${tool.accent}`}
              >
                <div class="tool-card-top">
                  <div
                    class="tool-icon"
                    style={`color: ${tool.accent}; background: color-mix(in srgb, ${tool.accent} 10%, transparent)`}
                  >
                    <Fragment set:html={tool.icon} />
                  </div>
                  <svg
                    class="tool-arrow"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14m-7-7 7 7-7 7" />
                  </svg>
                </div>
                <h3 class="tool-label">{tool.label}</h3>
                <p class="tool-desc">{tool.desc}</p>
                <div class="tool-tags">
                  {tool.tags?.map((tag) => (
                    <span class="tool-tag">{tag}</span>
                  ))}
                </div>
                <div
                  class="tool-card-bar"
                  style={`background: ${tool.accent}`}
                  aria-hidden="true"
                />
              </a>
            ))
          }
        </div>
      </div>

      <!-- CTA -->
      <div class="cta-outer">
        <div class="cta-section">
          <div class="cta-spectrum" aria-hidden="true">
            {
              colorFamilies?.map((c) => (
                <div class="cta-bar" style={`background: ${c.baseHex}`} />
              ))
            }
          </div>
          <div class="cta-content">
            <h2 class="cta-title">Explore color families &amp; palettes</h2>
            <p class="cta-desc">
              Browse {colorFamilies.length} color families with complete shade scales
              and curated palettes.
            </p>
            <div class="cta-actions">
              <a href="/" class="cta-link">Browse Colors →</a>
              <a href="/palettes" class="cta-link cta-link--ghost"
                >View Palettes →</a
              >
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .tools-page {
    min-height: 100dvh;
  }

  /* ── Hero ─────────────────────────────────────────────────── */
  .tools-hero {
    padding: 64px 24px 48px;
    text-align: center;
    border-bottom: 1px solid var(--border-subtle);
    overflow: hidden;
  }

  .hero-inner {
    max-width: 880px;
    margin: 0 auto;
  }

  .tools-badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--orange);
    background: color-mix(in srgb, var(--orange) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--orange) 25%, transparent);
    padding: 4px 14px;
    border-radius: 999px;
    margin-bottom: 24px;
    opacity: 0;
  }

  .hero-title {
    font-family: "Caveat", cursive, sans-serif;
    font-size: clamp(40px, 7vw, 72px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--text-primary);
    margin-bottom: 16px;
    opacity: 0;
  }

  /* Matches about.astro .title-accent exactly */
  .title-accent {
    background: linear-gradient(
      135deg,
      var(--orange) 0%,
      #ec4899 60%,
      #8b5cf6 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-desc {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 32px;
    opacity: 0;
  }

  .hero-strip {
    display: flex;
    height: 10px;
    border-radius: 999px;
    overflow: hidden;
    max-width: 480px;
    margin: 0 auto;
    box-shadow: var(--shadow-sm);
  }

  .strip-swatch {
    flex: 1;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-top: 28px;
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }

  .hero-stat-num {
    font-family: "Caveat", cursive, sans-serif;
    font-size: 28px;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1;
  }

  .hero-stat-label {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .hero-stat-divider {
    width: 1px;
    height: 28px;
    background: var(--border);
    flex-shrink: 0;
  }

  /* ── Tools Section ────────────────────────────────────────── */
  .tools-section {
    padding: 64px 24px 80px;
  }

  .tools-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: 32px;
  }

  .section-title {
    font-family: "Caveat", cursive, sans-serif;
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin-bottom: 6px;
  }

  .section-sub {
    font-size: 13px;
    color: var(--text-muted);
  }

  /* ── Tools Grid ───────────────────────────────────────────── */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
    margin-bottom: 64px;
  }

  /* ── Tool Card ────────────────────────────────────────────── */
  .tool-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    background: var(--white);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    text-decoration: none;
    overflow: hidden;
    opacity: 0;
    animation: fadeInUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base),
      border-color var(--transition-base);
  }

  .tool-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent);
  }

  .tool-card:hover .tool-arrow {
    transform: translateX(4px);
    color: var(--accent);
  }

  .tool-card:hover .tool-card-bar {
    opacity: 1;
  }

  .tool-card-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .tool-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
  }

  .tool-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    flex-shrink: 0;
  }

  .tool-arrow {
    color: var(--text-muted);
    transition:
      transform var(--transition-base),
      color var(--transition-base);
    flex-shrink: 0;
  }

  .tool-label {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 2px;
  }

  .tool-desc {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-muted);
    flex: 1;
  }

  .tool-tags {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
    margin-top: 6px;
  }

  .tool-tag {
    font-size: 10px;
    font-weight: 500;
    color: var(--text-muted);
    background: var(--light);
    border: 1px solid var(--border-subtle);
    padding: 2px 8px;
    border-radius: 999px;
    letter-spacing: 0.02em;
    text-transform: lowercase;
  }

  /* ── CTA ──────────────────────────────────────────────────── */
  .cta-outer {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ── Animation ────────────────────────────────────────────── */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tool-card {
      animation: none;
      opacity: 1;
    }
  }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 768px) {
    .tools-grid {
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    }
  }

  @media (max-width: 640px) {
    .tools-hero {
      padding: 48px 16px 36px;
    }
    .tools-section {
      padding: 40px 16px 60px;
    }
    .cta-outer {
      padding: 0 16px 60px;
    }
    .tools-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
