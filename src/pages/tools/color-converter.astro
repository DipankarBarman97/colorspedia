---
import Layout from "../../layouts/Layout.astro";
import { colorFamilies } from "../../data/colors";
import { paletteSets } from "../../data/palettes";

const popularColors = [
  { name: "Sunset Orange", hex: "#f97316" },
  { name: "Sky Blue", hex: "#0ea5e9" },
  { name: "Emerald", hex: "#10b981" },
  { name: "Rose", hex: "#f43f5e" },
  { name: "Violet", hex: "#8b5cf6" },
  { name: "Amber", hex: "#f59e0b" },
  { name: "Slate", hex: "#64748b" },
  { name: "Teal", hex: "#14b8a6" },
];

const colorFamilyData = colorFamilies?.map((c) => ({
  name: c.name,
  slug: c.slug,
  baseHex: c.baseHex,
}));
---

<Layout
  title="Color Converter — Colorspedia"
  description="Convert any color between HEX, RGB, HSL, HSB/HSV, and CMYK instantly. Copy values ready for CSS, Tailwind, and design tools."
>
  <div class="converter-page">
    <!-- ── Hero ──────────────────────────────────────────────────── -->
    <section class="conv-hero mesh-bg">
      <div class="hero-inner">
        <div class="conv-badge animate-fade-in-up">Color Tools</div>
        <h1 class="hero-title animate-fade-in-up stagger-1">
          Color <span class="title-accent">Converter</span>
        </h1>
        <p class="hero-desc animate-fade-in-up stagger-2">
          Paste any color value and get instant, copy-ready conversions across
          HEX, RGB, HSL, HSB, and CMYK.
        </p>
        <div class="hero-strip animate-fade-in-up stagger-3" aria-hidden="true">
          {
            paletteSets
              .slice(0, 4)
              .flatMap((p) =>
                p.colors?.map((color) => (
                  <div class="strip-swatch" style={`background:${color.hex}`} />
                )),
              )
          }
        </div>
      </div>
    </section>

    <!-- ── Main converter ─────────────────────────────────────────── -->
    <section class="conv-section">
      <div class="conv-inner">
        <!-- Input card -->
        <div class="input-card animate-fade-in-up">
          <div class="input-card-left">
            <div class="preview-swatch-wrap">
              <div
                class="preview-swatch"
                id="preview-swatch"
                style="background: var(--light)"
              >
              </div>
              <input
                type="color"
                id="color-picker"
                value="#f97316"
                class="native-picker"
                title="Open color picker"
                aria-label="Open color picker"
              />
            </div>
            <div class="main-input-wrap">
              <label class="input-label" for="main-input"
                >Enter any color value</label
              >
              <input
                type="text"
                id="main-input"
                class="main-input"
                value=""
                placeholder="#f97316 · rgb(249,115,22) · hsl(24,95%,53%)"
                spellcheck="false"
                autocomplete="off"
              />
              <div class="input-hint" id="input-hint">Enter a color above</div>
            </div>
          </div>
          <div class="input-card-actions">
            <button class="btn-action btn-clear" id="btn-clear">
              <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M18 6L6 18M6 6l12 12"></path></svg
              >
              Clear
            </button>
            <button class="btn-action btn-random" id="btn-random">
              <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><polyline points="16 3 21 3 21 8"></polyline><line
                  x1="4"
                  y1="20"
                  x2="21"
                  y2="3"></line><polyline points="21 16 21 21 16 21"
                ></polyline><line x1="15" y1="15" x2="21" y2="21"></line></svg
              >
              Random
            </button>
          </div>
        </div>

        <!-- Error banner -->
        <div
          class="error-banner"
          id="error-banner"
          style="display:none"
          role="alert"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="12" cy="12" r="10"></circle><line
              x1="12"
              y1="8"
              x2="12"
              y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"
            ></line></svg
          >
          <span id="error-text">Couldn't parse that color.</span>
        </div>

        <!-- Output grid -->
        <div class="output-grid" id="output-grid">
          <!-- HEX -->
          <div class="format-card">
            <div class="format-head">
              <div class="format-label-wrap">
                <span class="format-name">HEX</span>
                <span class="format-badge">Web</span>
              </div>
              <button class="copy-btn" data-target="val-hex">
                <svg
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><rect x="9" y="9" width="13" height="13" rx="2"></rect><path
                    d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                  ></path></svg
                >
                Copy
              </button>
            </div>
            <div class="format-value mono large empty-val" id="val-hex">—</div>
            <div class="channel-row">
              <div class="channel-chip">
                <span class="ch-label">R</span><span class="ch-val" id="hex-r"
                  >—</span
                >
              </div>
              <div class="channel-chip">
                <span class="ch-label">G</span><span class="ch-val" id="hex-g"
                  >—</span
                >
              </div>
              <div class="channel-chip">
                <span class="ch-label">B</span><span class="ch-val" id="hex-b"
                  >—</span
                >
              </div>
            </div>
          </div>

          <!-- RGB -->
          <div class="format-card">
            <div class="format-head">
              <div class="format-label-wrap">
                <span class="format-name">RGB</span>
                <span class="format-badge">CSS</span>
              </div>
              <button class="copy-btn" data-target="val-rgb">
                <svg
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><rect x="9" y="9" width="13" height="13" rx="2"></rect><path
                    d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                  ></path></svg
                >
                Copy
              </button>
            </div>
            <div class="format-value mono large empty-val" id="val-rgb">—</div>
            <div class="channel-row">
              <div class="channel-chip">
                <span class="ch-label">R</span><span class="ch-val" id="rgb-r"
                  >—</span
                >
              </div>
              <div class="channel-chip">
                <span class="ch-label">G</span><span class="ch-val" id="rgb-g"
                  >—</span
                >
              </div>
              <div class="channel-chip">
                <span class="ch-label">B</span><span class="ch-val" id="rgb-b"
                  >—</span
                >
              </div>
            </div>
          </div>

          <!-- HSL -->
          <div class="format-card">
            <div class="format-head">
              <div class="format-label-wrap">
                <span class="format-name">HSL</span>
                <span class="format-badge">CSS</span>
              </div>
              <button class="copy-btn" data-target="val-hsl">
                <svg
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><rect x="9" y="9" width="13" height="13" rx="2"></rect><path
                    d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                  ></path></svg
                >
                Copy
              </button>
            </div>
            <div class="format-value mono large empty-val" id="val-hsl">—</div>
            <div class="channel-row">
              <div class="channel-chip">
                <span class="ch-label">H</span><span class="ch-val" id="hsl-h"
                  >—</span
                >
              </div>
              <div class="channel-chip">
                <span class="ch-label">S</span><span class="ch-val" id="hsl-s"
                  >—</span
                >
              </div>
              <div class="channel-chip">
                <span class="ch-label">L</span><span class="ch-val" id="hsl-l"
                  >—</span
                >
              </div>
            </div>
          </div>

          <!-- HSB -->
          <div class="format-card">
            <div class="format-head">
              <div class="format-label-wrap">
                <span class="format-name">HSB</span>
                <span class="format-badge">Figma / PS</span>
              </div>
              <button class="copy-btn" data-target="val-hsb">
                <svg
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><rect x="9" y="9" width="13" height="13" rx="2"></rect><path
                    d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                  ></path></svg
                >
                Copy
              </button>
            </div>
            <div class="format-value mono large empty-val" id="val-hsb">—</div>
            <div class="channel-row">
              <div class="channel-chip">
                <span class="ch-label">H</span><span class="ch-val" id="hsb-h"
                  >—</span
                >
              </div>
              <div class="channel-chip">
                <span class="ch-label">S</span><span class="ch-val" id="hsb-s"
                  >—</span
                >
              </div>
              <div class="channel-chip">
                <span class="ch-label">B</span><span class="ch-val" id="hsb-b"
                  >—</span
                >
              </div>
            </div>
          </div>

          <!-- CMYK -->
          <div class="format-card">
            <div class="format-head">
              <div class="format-label-wrap">
                <span class="format-name">CMYK</span>
                <span class="format-badge">Print</span>
              </div>
              <button class="copy-btn" data-target="val-cmyk">
                <svg
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><rect x="9" y="9" width="13" height="13" rx="2"></rect><path
                    d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                  ></path></svg
                >
                Copy
              </button>
            </div>
            <div class="format-value mono large empty-val" id="val-cmyk">—</div>
            <div class="channel-row">
              <div class="channel-chip">
                <span class="ch-label">C</span><span class="ch-val" id="cmyk-c"
                  >—</span
                >
              </div>
              <div class="channel-chip">
                <span class="ch-label">M</span><span class="ch-val" id="cmyk-m"
                  >—</span
                >
              </div>
              <div class="channel-chip">
                <span class="ch-label">Y</span><span class="ch-val" id="cmyk-y"
                  >—</span
                >
              </div>
              <div class="channel-chip">
                <span class="ch-label">K</span><span class="ch-val" id="cmyk-k"
                  >—</span
                >
              </div>
            </div>
          </div>

          <!-- CSS snippet — full width -->
          <div class="format-card format-card--wide">
            <div class="format-head">
              <div class="format-label-wrap">
                <span class="format-name">CSS Variables</span>
                <span class="format-badge">Code</span>
              </div>
              <button class="copy-btn" data-target="val-css">
                <svg
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><rect x="9" y="9" width="13" height="13" rx="2"></rect><path
                    d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                  ></path></svg
                >
                Copy
              </button>
            </div>
            <pre
              class="code-block"><code id="val-css">/* Enter a color above to generate CSS variables */</code></pre>
          </div>
        </div>

        <!-- Info strip -->
        <div class="info-strip">
          <div class="info-item">
            <span class="info-label">Luminance</span>
            <span class="info-val mono" id="info-lum">—</span>
          </div>
          <div class="info-divider"></div>
          <div class="info-item">
            <span class="info-label">Best text on this color</span>
            <div class="contrast-demo">
              <span class="contrast-pill contrast-pill--dark" id="contrast-dark"
                >Dark</span
              >
              <span
                class="contrast-pill contrast-pill--light"
                id="contrast-light">Light</span
              >
            </div>
          </div>
          <div class="info-divider"></div>
          <div class="info-item">
            <span class="info-label">Nearest Colorspedia family</span>
            <a class="info-val info-link" id="info-nearest" href="#">—</a>
          </div>
        </div>

        <!-- Quick picks -->
        <div class="quickpick-section">
          <h2 class="quickpick-title">Quick picks</h2>
          <div class="quickpick-grid">
            {
              popularColors?.map((c) => (
                <button
                  class="quickpick-btn"
                  style={`background:${c.hex}`}
                  data-hex={c.hex}
                  aria-label={`Use ${c.name} (${c.hex})`}
                >
                  <span class="qp-tooltip">
                    {c.name}
                    <br />
                    <span class="qp-hex">{c.hex}</span>
                  </span>
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="cta-outer">
        <div class="cta-section">
          <div class="cta-spectrum" aria-hidden="true">
            {
              colorFamilies?.map((c) => (
                <div class="cta-bar" style={`background: ${c.baseHex}`} />
              ))
            }
          </div>
          <div class="cta-content">
            <h2 class="cta-title">Explore complete color families</h2>
            <p class="cta-desc">
              Browse {colorFamilies.length} color families with full 50–950 shade
              scales and copy-ready CSS, Tailwind, and SCSS.
            </p>
            <div class="cta-actions">
              <a href="/" class="cta-link">Browse Colors →</a>
              <a href="/palettes" class="cta-link cta-link--ghost"
                >View Palettes →</a
              >
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<div class="toast" id="conv-toast" aria-live="polite">Copied!</div>

<style>
  .converter-page {
    min-height: 100dvh;
  }

  /* ── Hero ──────────────────────────────────────────────────── */
  .conv-hero {
    padding: 64px 24px 48px;
    text-align: center;
    border-bottom: 1px solid var(--border-subtle);
    overflow: hidden;
  }
  .hero-inner {
    max-width: 880px;
    margin: 0 auto;
  }
  .conv-badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--orange);
    background: color-mix(in srgb, var(--orange) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--orange) 25%, transparent);
    padding: 4px 14px;
    border-radius: 999px;
    margin-bottom: 24px;
    opacity: 0;
  }
  .hero-title {
    font-family: "Caveat", cursive, sans-serif;
    font-size: clamp(40px, 7vw, 72px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--text-primary);
    margin-bottom: 16px;
    opacity: 0;
  }
  .title-accent {
    background: linear-gradient(
      135deg,
      var(--orange) 0%,
      #ec4899 60%,
      #8b5cf6 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-desc {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 32px;
    opacity: 0;
  }
  .hero-strip {
    display: flex;
    height: 10px;
    border-radius: 999px;
    overflow: hidden;
    max-width: 480px;
    margin: 0 auto;
    box-shadow: var(--shadow-sm);
  }
  .strip-swatch {
    flex: 1;
  }

  /* ── Section shell ─────────────────────────────────────────── */
  .conv-section {
    padding: 40px 24px 80px;
  }
  .conv-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  /* ── Input card ────────────────────────────────────────────── */
  .input-card {
    background: var(--white);
    border: 1.5px solid var(--border);
    border-radius: 20px;
    padding: 22px 24px;
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 12px;
    box-shadow: var(--shadow-sm);
    flex-wrap: wrap;
    opacity: 0;
    animation: fadeInUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.05s forwards;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .input-card:focus-within {
    border-color: var(--orange);
    box-shadow:
      0 0 0 4px color-mix(in srgb, var(--orange) 12%, transparent),
      var(--shadow-sm);
  }
  .input-card-left {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: 1;
    min-width: 0;
  }
  .preview-swatch-wrap {
    position: relative;
    flex-shrink: 0;
  }
  .preview-swatch {
    width: 64px;
    height: 64px;
    border-radius: 14px;
    box-shadow: var(--shadow-md);
    cursor: pointer;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      background 0.2s ease;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }
  .preview-swatch:hover {
    transform: scale(1.06);
    box-shadow: var(--shadow-lg);
  }
  /* Checkerboard pattern when no color is set */
  .preview-swatch.is-empty {
    background: repeating-conic-gradient(
        var(--border-subtle) 0% 25%,
        var(--white) 0% 50%
      )
      0 0 / 16px 16px !important;
    border: 1.5px dashed var(--border);
    box-shadow: none;
  }
  .native-picker {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
    width: 100%;
    height: 100%;
    border: none;
    padding: 0;
  }
  .main-input-wrap {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .input-label {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }
  .main-input {
    width: 100%;
    font-family: "DM Mono", monospace;
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
    border: none;
    background: transparent;
    outline: none;
    min-width: 0;
    letter-spacing: 0.01em;
  }
  .main-input::placeholder {
    color: var(--text-muted);
    font-weight: 400;
    font-size: 14px;
  }
  .input-hint {
    font-size: 10px;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--light);
    border: 1px solid var(--border-subtle);
    padding: 2px 8px;
    border-radius: 999px;
    display: inline-flex;
    width: fit-content;
    transition: all 0.15s ease;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .input-hint.is-active {
    color: var(--orange);
    background: color-mix(in srgb, var(--orange) 10%, transparent);
    border-color: color-mix(in srgb, var(--orange) 20%, transparent);
  }
  .input-hint.is-error {
    color: #dc2626;
    background: color-mix(in srgb, #dc2626 10%, transparent);
    border-color: color-mix(in srgb, #dc2626 20%, transparent);
  }
  .input-card-actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }
  .btn-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    border: 1.5px solid var(--border);
    background: var(--white);
    color: var(--text-secondary);
  }
  .btn-clear:hover {
    border-color: #dc2626;
    color: #dc2626;
    background: color-mix(in srgb, #dc2626 6%, transparent);
  }
  .btn-random:hover {
    border-color: var(--orange);
    color: var(--orange);
    background: color-mix(in srgb, var(--orange) 6%, transparent);
  }

  /* ── Error banner ──────────────────────────────────────────── */
  .error-banner {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: color-mix(in srgb, #dc2626 8%, transparent);
    border: 1px solid color-mix(in srgb, #dc2626 20%, transparent);
    border-radius: 10px;
    font-size: 13px;
    font-weight: 500;
    color: #dc2626;
    margin-bottom: 16px;
  }

  /* ── Output grid ───────────────────────────────────────────── */
  .output-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;
    margin-bottom: 14px;
  }

  /* ── Empty value style ─────────────────────────────────────── */
  .empty-val {
    color: var(--text-muted) !important;
  }

  /* ── Format card ───────────────────────────────────────────── */
  .format-card {
    background: var(--white);
    border: 1.5px solid var(--border-subtle);
    border-radius: 16px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
    animation: cardIn 0.4s ease both;
  }
  .format-card:hover {
    border-color: var(--orange);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--orange) 12%, transparent);
    transform: translateY(-2px);
  }
  .format-card--wide {
    grid-column: 1 / -1;
  }

  @keyframes cardIn {
