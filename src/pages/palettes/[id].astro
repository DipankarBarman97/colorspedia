  .pnav-link:hover .pnav-dot { transform: scale(1.1); }

  .pnav-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .pnav-dir  {
    font-size: 11px;
    color: var(--text-muted);
    font-weight: 500;
    white-space: nowrap;
    letter-spacing: .04em;
  }
  .pnav-name {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color .2s;
  }
  .pnav-link:hover .pnav-name { color: var(--orange); }

  .pnav-empty {
    font-size: 13px;
    color: var(--text-muted);
    padding: 12px 0;
    font-style: italic;
  }
  .pnav-empty--right { text-align: right; width: 100%; }

  .pnav-all {
    padding: 11px 24px;
    border-radius: var(--radius-sm);
    background: var(--orange);
    color: var(--white);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background .15s, transform .15s, box-shadow .15s;
    text-align: center;
    flex-shrink: 0;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--orange) 35%, transparent);
  }
  .pnav-all:hover {
    background: var(--orange-hover);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px color-mix(in srgb, var(--orange) 35%, transparent);
  }

  /* ── pnav responsive ───────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .pnav-inner {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      padding: 16px 20px;
      gap: 12px;
    }
    .pnav-slot--prev { flex: 1; min-width: 0; order: 1; justify-content: flex-start; }
    .pnav-slot--next { flex: 1; min-width: 0; order: 2; justify-content: flex-end; }
    .pnav-all        { order: 3; flex-shrink: 0; }
    .pnav-empty      { width: auto; padding: 10px 0; white-space: nowrap; }
    .pnav-empty--right { text-align: right; }
    .pnav-link       { padding: 10px 14px; gap: 8px; }
    .pnav-dots       { display: none; }
    .pnav-name       { font-size: 13px; }
  }

  @media (max-width: 640px) {
    .pnav-inner {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      padding: 12px 16px;
      gap: 10px;
    }
    .pnav-slot--prev { flex: 1; min-width: 0; order: 1; justify-content: flex-start; }
    .pnav-slot--next { flex: 1; min-width: 0; order: 2; justify-content: flex-end; }
    .pnav-all        { display: none; }
    .pnav-empty      { width: auto; padding: 8px 0; white-space: nowrap; font-size: 12px; }
    .pnav-empty--right { text-align: right; }
    .pnav-link       { padding: 10px 12px; gap: 7px; width: 100%; }
    .pnav-slot--next .pnav-link { flex-direction: row-reverse; }
    .pnav-dots       { display: none; }
    .pnav-dir        { font-size: 10px; }
    .pnav-name       { font-size: 12px; }
  }

  /* ── Toast ──────────────────────────────────────────────────────────── */
  .toast {
    position: fixed;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%) translateY(12px);
    background: #111827;
    color: var(--white);
    font-family: "DM Mono", "Courier New", monospace;
    font-size: 13px;
    font-weight: 500;
    padding: 10px 20px;
    border-radius: 10px;
    box-shadow: var(--shadow-lg);
    opacity: 0;
    pointer-events: none;
    transition: opacity .2s, transform .2s;
    /* Below header (64px z-index) but above content */
    z-index: 80;
    white-space: nowrap;
    max-width: calc(100vw - 32px);
    text-overflow: ellipsis;
    overflow: hidden;
