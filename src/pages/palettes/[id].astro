    box-shadow: 0 6px 16px rgba(0,0,0,.18);
    z-index: 1;
  }
  .swatch-row-btn:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 2px;
  }
  .swatch-row-name {
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 90px;
  }
  .swatch-row-hex {
    font-family: "DM Mono", "Courier New", monospace;
    font-size: 10px;
    opacity: .7;
    flex-shrink: 0;
  }

  /* ── Shared section shell ───────────────────────────────────────────── */
  .section-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }
  .section-title {
    font-family: "Caveat", cursive, sans-serif;
    font-size: clamp(1.25rem, 2.5vw, 1.6rem);
    font-weight: 800;
    letter-spacing: -.02em;
    color: var(--text-primary);
    margin-bottom: 4px;
  }
  .section-sub {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* ── Format toggle ──────────────────────────────────────────────────── */
  .fmt-toggle {
    display: flex;
    gap: 3px;
    background: var(--light);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 3px;
    flex-shrink: 0;
  }
  .fmt-btn {
    padding: 5px 14px;
    border-radius: 7px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .07em;
    border: none;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    font-family: "DM Mono", "Courier New", monospace;
    transition: background .15s, color .15s, box-shadow .15s;
  }
  .fmt-btn--active {
    background: var(--white);
    color: var(--text-primary);
    box-shadow: var(--shadow-sm);
  }
  .fmt-btn:hover:not(.fmt-btn--active) { color: var(--text-secondary); }

  /* ── Colour cards ───────────────────────────────────────────────────── */
  .cards-section {
    padding: 48px 0;
    border-bottom: 1px solid var(--border);
  }

  .color-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(185px, 1fr));
    gap: 12px;
  }

  .color-card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    cursor: pointer;
    text-align: left;
    background: var(--white);
    box-shadow: var(--shadow-sm);
    /* Use translate + outline for hover — avoids color-mix FF bug */
    transition: transform .2s var(--ease-spring), box-shadow .2s, border-color .2s;
    opacity: 0;
    animation: cardIn .4s var(--ease-spring) forwards;
    padding: 0; /* reset button default */
  }
  .color-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
    border-color: rgba(0,0,0,.15);
  }
  .color-card:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 2px;
  }

  @keyframes cardIn {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .card-swatch {
    height: 112px;
    position: relative;
    overflow: hidden;
  }

  /* Copy overlay: hidden by default via class, not inline style */
  .card-copy-hint {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 600;
    background: rgba(0,0,0,.2);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity .15s;
    pointer-events: none;
  }
  /* Show on hover AND after copy */
  .color-card.copied .card-copy-hint { opacity: 1; }

  .card-body {
    padding: 10px 13px 13px;
    border-top: 1px solid rgba(0,0,0,.06);
  }
  .card-name {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 4px;
