---
import Layout from "../../layouts/Layout.astro";
import { colorFamilies } from "../../data/colors";
import { paletteSets } from "../../data/palettes";

export async function getStaticPaths() {
  return paletteSets?.map((palette) => ({
    params: { id: palette.id },
    props: { palette },
  }));
}

const { palette } = Astro.props;

const currentIdx = paletteSets.findIndex((p) => p.id === palette.id);
const prevPalette = paletteSets[currentIdx - 1] ?? null;
const nextPalette = paletteSets[currentIdx + 1] ?? null;

const related = paletteSets
  .filter(
    (p) => p.id !== palette.id && p.tags.some((t) => palette.tags.includes(t)),
  )
  .slice(0, 3);

// Find related color families based on approximate hue match
const relatedFamilies = colorFamilies
  .filter((cf) =>
    palette.colors.some((pc) => {
      const pr = parseInt(pc.hex.slice(1, 3), 16);
      const pg = parseInt(pc.hex.slice(3, 5), 16);
      const pb = parseInt(pc.hex.slice(5, 7), 16);
      const fr = parseInt(cf.baseHex.slice(1, 3), 16);
      const fg = parseInt(cf.baseHex.slice(3, 5), 16);
      const fb = parseInt(cf.baseHex.slice(5, 7), 16);
      return (
        Math.abs(pr - fr) < 40 &&
        Math.abs(pg - fg) < 40 &&
        Math.abs(pb - fb) < 40
      );
    }),
  )
  .slice(0, 4);

// ── Colour helpers (server-side) ─────────────────────────────────────────────
function getLum(hex: string) {
  const r = parseInt(hex.slice(1, 3), 16) / 255;
  const g = parseInt(hex.slice(3, 5), 16) / 255;
  const b = parseInt(hex.slice(5, 7), 16) / 255;
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
}

function getTextColor(hex: string) {
  return getLum(hex) > 0.45 ? "#1c1917" : "#ffffff";
}

function hexToRgb(hex: string) {
  return `${parseInt(hex.slice(1, 3), 16)}, ${parseInt(hex.slice(3, 5), 16)}, ${parseInt(hex.slice(5, 7), 16)}`;
}

function hexToHsl(hex: string) {
  let r = parseInt(hex.slice(1, 3), 16) / 255,
    g = parseInt(hex.slice(3, 5), 16) / 255,
    b = parseInt(hex.slice(5, 7), 16) / 255;
  const max = Math.max(r, g, b), min = Math.min(r, g, b);
  let h = 0, s = 0;
  const l = (max + min) / 2;
  if (max !== min) {
    const d = max - min;
    s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
    switch (max) {
      case r: h = ((g - b) / d + (g < b ? 6 : 0)) / 6; break;
      case g: h = ((b - r) / d + 2) / 6; break;
      case b: h = ((r - g) / d + 4) / 6; break;
    }
  }
  return `${Math.round(h * 360)}°, ${Math.round(s * 100)}%, ${Math.round(l * 100)}%`;
}

// Precompute values so templates stay clean
const paletteWithValues = palette.colors?.map((color) => ({
  ...color,
  tc:    getTextColor(color.hex),
  rgb:   hexToRgb(color.hex),
  hsl:   hexToHsl(color.hex),
}));
---

<Layout
  title={`${palette.name} Color Palette — Colorspedia`}
  description={palette.longDescription}
>
  <div class="palette-detail">

    <!-- ── Breadcrumb ──────────────────────────────────────────────────────── -->
    <div class="breadcrumb-bar">
      <div class="breadcrumb-inner">
        <a href="/"        class="bc-link">Colors</a>
        <span class="bc-sep" aria-hidden="true">›</span>
        <a href="/palettes" class="bc-link">Palettes</a>
        <span class="bc-sep" aria-hidden="true">›</span>
        <span class="bc-current">{palette.name}</span>
      </div>
    </div>

    <!-- ── Hero ──────────────────────────────────────────────────────────── -->
    <section class="hero">

      <!-- Animated colour strip -->
      <div class="hero-strip" role="img" aria-label={`${palette.name} colour strip`}>
        {paletteWithValues?.map((color, i) => (
          <button
            class="strip-swatch"
            style={`background:${color.hex}; animation-delay:${i * 0.07}s`}
            data-hex={color.hex}
            aria-label={`Copy ${color.name} — ${color.hex}`}
          >
            <span class="strip-info">
              <span class="strip-name">{color.name}</span>
              <span class="strip-hex">{color.hex}</span>
            </span>
          </button>
        ))}
      </div>

      <!-- Meta: title + actions + swatch sidebar -->
      <div class="hero-body">
        <div class="hero-left">
          <!-- Tags -->
          <div class="palette-chips" role="list">
            {palette.tags?.map((tag) => (
              <span class="palette-chip" role="listitem">{tag}</span>
            ))}
            <span class="palette-chip palette-chip--mood">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                <line x1="9" y1="9" x2="9.01" y2="9"/>
                <line x1="15" y1="9" x2="15.01" y2="9"/>
              </svg>
              {palette.mood}
            </span>
          </div>

          <h1 class="hero-title">{palette.name}</h1>
          <p class="hero-desc">{palette.longDescription}</p>

          <!-- Action row -->
          <div class="hero-actions">
            <button
              class="btn-primary"
              id="copy-all-btn"
              data-hexes={palette.colors?.map((c) => c.hex).join(",")}
              aria-label="Copy all hex codes to clipboard"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2"/>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
              </svg>
              Copy All
            </button>
            <button
              class="btn-secondary"
              id="copy-css-vars-btn"
              aria-label="Copy CSS variables to clipboard"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="16 18 22 12 16 6"/>
                <polyline points="8 6 2 12 8 18"/>
              </svg>
              Copy CSS
            </button>
          </div>

          <!-- Quick stat pills -->
          <div class="hero-stats">
            <div class="hero-stat">
              <span class="hero-stat-num">{palette.colors.length}</span>
              <span class="hero-stat-label">Colors</span>
            </div>
            <div class="hero-stat">
              <span class="hero-stat-num">{palette.tags.length}</span>
              <span class="hero-stat-label">Tags</span>
            </div>
            <div class="hero-stat">
              <span class="hero-stat-num">3</span>
              <span class="hero-stat-label">Formats</span>
            </div>
          </div>
        </div>

        <!-- Swatch sidebar — visible only on ≥ md -->
        <aside class="hero-right" aria-label="Colour swatches">
          <div class="swatch-column">
            {paletteWithValues?.map((color) => (
              <button
                class="swatch-row-btn copy-swatch"
                style={`background:${color.hex}`}
                data-hex={color.hex}
                aria-label={`Copy ${color.name} — ${color.hex}`}
              >
                <span class="swatch-row-name" style={`color:${color.tc}`}>
                  {color.name}
                </span>
                <span class="swatch-row-hex" style={`color:${color.tc}`}>
                  {color.hex}
                </span>
              </button>
            ))}
          </div>
        </aside>
      </div>
    </section>

    <!-- ── Colour Cards ──────────────────────────────────────────────────── -->
    <section class="cards-section">
      <div class="section-inner">
        <div class="section-head">
          <div>
            <h2 class="section-title">Palette Colours</h2>
            <p class="section-sub">Click any card to copy. Toggle format below.</p>
          </div>
          <!-- Format toggle -->
          <div class="fmt-toggle" role="group" aria-label="Colour format">
            <button class="fmt-btn fmt-btn--active" data-fmt="hex">HEX</button>
            <button class="fmt-btn"                 data-fmt="rgb">RGB</button>
            <button class="fmt-btn"                 data-fmt="hsl">HSL</button>
          </div>
        </div>

        <div class="color-cards">
          {paletteWithValues?.map((color, i) => (
            <button
              class="color-card"
              data-hex={color.hex}
              data-rgb={`rgb(${color.rgb})`}
              data-hsl={`hsl(${color.hsl})`}
              style={`--card-bg:${color.hex}; animation-delay:${i * 0.06}s`}
              aria-label={`Copy ${color.name} — ${color.hex}`}
            >
              <div class="card-swatch" style={`background:${color.hex}`}>
                <!-- Copy confirm overlay — driven purely by JS class, no inline opacity -->
                <div class="card-copy-hint" style={`color:${color.tc}`} aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2.5"
                    stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  Copied!
                </div>
              </div>
              <div class="card-body">
                <div class="card-name">{color.name}</div>
                <div class="card-vals">
                  <span class="val val-hex">{color.hex}</span>
                  <span class="val val-rgb" hidden>rgb({color.rgb})</span>
                  <span class="val val-hsl" hidden>hsl({color.hsl})</span>
                </div>
              </div>
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Usage + Mood + Code ──────────────────────────────────────────── -->
    <section class="usage-section">
      <div class="section-inner usage-grid">

        <!-- Best used for -->
        <div class="usage-card">
          <div class="usage-icon" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          </div>
          <h3 class="usage-title">Best Used For</h3>
          <ul class="usage-list">
            {palette.bestFor?.map((item) => (
              <li class="usage-item">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="3"
                  stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- Mood -->
        <div class="usage-card">
          <div class="usage-icon" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
              <line x1="9" y1="9" x2="9.01" y2="9"/>
              <line x1="15" y1="9" x2="15.01" y2="9"/>
            </svg>
          </div>
          <h3 class="usage-title">Mood &amp; Tone</h3>
          <p class="usage-mood-name">{palette.mood}</p>
          <div class="mood-bar" aria-hidden="true">
            {palette.colors?.map((c) => (
              <div class="mood-seg" style={`background:${c.hex}`}/>
            ))}
          </div>
          <div class="mood-tags">
            {palette.tags?.map((t) => (
              <span class="mood-tag">{t}</span>
            ))}
          </div>
        </div>

        <!-- CSS snippet -->
        <div class="usage-card usage-card--code">
          <div class="usage-icon" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2">
              <polyline points="16 18 22 12 16 6"/>
              <polyline points="8 6 2 12 8 18"/>
            </svg>
          </div>
          <h3 class="usage-title">CSS Variables</h3>
          <pre class="code-block"><code id="css-code-content">{`:root {\n${palette.colors?.map((c, i) => `  --palette-${i + 1}: ${c.hex}; /* ${c.name} */`).join("\n")}\n}`}</code></pre>
          <button class="copy-code-btn" id="copy-snippet-btn" aria-label="Copy CSS variables">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.5"
              stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            Copy CSS
          </button>
        </div>

      </div>
    </section>

    <!-- ── Related Colour Families ──────────────────────────────────────── -->
    {relatedFamilies.length > 0 && (
      <section class="families-section">
        <div class="section-inner">
          <h2 class="section-title">Related Colour Families</h2>
          <p class="section-sub">
            Explore the full shade scale for colours used in this palette.
          </p>
          <div class="families-grid">
            {relatedFamilies?.map((cf) => {
              const tc = getTextColor(cf.baseHex);
              return (
                <a
                  href={`/colors/${cf.slug}`}
                  class="family-card"
                  style={`--fc:${cf.baseHex}`}
                >
                  <div class="family-shade-strip">
                    {cf.shades?.map((s) => (
                      <div style={`background:${s.hex};flex:1`}/>
                    ))}
                  </div>
                  <div class="family-swatch" style={`background:${cf.baseHex}`}>
                    <span class="family-name" style={`color:${tc}`}>{cf.name}</span>
                    <span class="family-hex"  style={`color:${tc}`}>{cf.baseHex}</span>
                  </div>
                  <div class="family-footer">
                    <span class="family-count">{cf.shades.length} shades</span>
                    <span class="family-arrow" aria-hidden="true">→</span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- ── Related Palettes ──────────────────────────────────────────────── -->
    {related.length > 0 && (
      <section class="related-section">
        <div class="section-inner">
          <h2 class="section-title">Similar Palettes</h2>
          <div class="related-grid">
            {related?.map((rp) => (
              <a href={`/palettes/${rp.id}`} class="related-card">
                <div class="related-strip">
                  {rp.colors?.map((c) => (
                    <div class="related-seg" style={`background:${c.hex}`}/>
                  ))}
                </div>
                <div class="related-body">
                  <div class="related-name">{rp.name}</div>
                  <div class="related-desc">{rp.description}</div>
                  <div class="related-tags">
                    {rp.tags?.map((t) => (
                      <span class="related-tag">{t}</span>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ── Prev / Next nav ──────────────────────────────────────────────── -->
    <nav class="pnav" aria-label="Palette navigation">
      <div class="pnav-inner">
        <!-- Prev -->
        <div class="pnav-slot pnav-slot--prev">
          {prevPalette ? (
            <a href={`/palettes/${prevPalette.id}`} class="pnav-link">
              <div class="pnav-dots" aria-hidden="true">
                {prevPalette.colors?.map((c) => (
                  <div class="pnav-dot" style={`background:${c.hex}`}/>
                ))}
              </div>
              <div class="pnav-text">
                <span class="pnav-dir">← Previous</span>
                <span class="pnav-name">{prevPalette.name}</span>
              </div>
            </a>
          ) : (
            <span class="pnav-empty">First palette</span>
          )}
        </div>

        <!-- Home -->
        <a href="/palettes" class="pnav-all">All Palettes</a>

        <!-- Next -->
        <div class="pnav-slot pnav-slot--next">
          {nextPalette ? (
            <a href={`/palettes/${nextPalette.id}`} class="pnav-link pnav-link--next">
              <div class="pnav-text">
                <span class="pnav-dir">Next →</span>
                <span class="pnav-name">{nextPalette.name}</span>
              </div>
              <div class="pnav-dots" aria-hidden="true">
                {nextPalette.colors?.map((c) => (
                  <div class="pnav-dot" style={`background:${c.hex}`}/>
                ))}
              </div>
            </a>
          ) : (
            <span class="pnav-empty pnav-empty--right">Last palette</span>
          )}
        </div>
      </div>
    </nav>

  </div>

  <!-- Toast -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>
</Layout>

<!-- ─────────────────────────────────────────────────────────────────────────── -->
<style>
  /* ── Tokens ─────────────────────────────────────────────────────────────── */
  .palette-detail {
    --radius:    14px;
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    min-height: 100dvh;
  }

  /* ── Breadcrumb ─────────────────────────────────────────────────────────── */
  .breadcrumb-bar {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .breadcrumb-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
  }
  .bc-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    transition: color .15s;
  }
  .bc-link:hover { color: var(--orange); }
  .bc-sep   { color: var(--text-muted); }
  .bc-current { color: var(--text-primary); font-weight: 600; }

  /* ── Hero ──────────────────────────────────────────────────────────────── */
  .hero {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  /* Colour strip */
  .hero-strip {
    display: flex;
    height: 200px;
    /* No border-radius — bleeds edge to edge for visual impact */
  }

  .strip-swatch {
    flex: 1;
    border: none;
    padding: 0;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    /* Use translateX (not scaleY) to avoid Safari layout bug */
    opacity: 0;
    transform: translateY(8px);
    animation: stripIn .45s var(--ease-spring) forwards;
    transition: flex .35s var(--ease-spring);
  }
  .strip-swatch:hover { flex: 3; }
  .strip-swatch.copied .strip-info {
    transform: translateY(0);
    opacity: 1;
  }
  
  .strip-swatch.copied::after {
    content: "✓";
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    font-weight: 700;
    color: var(--white);
    background: rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(2px);
    animation: fadeInScale 0.2s ease forwards;
  }
  
  @keyframes fadeInScale {
    from { opacity: 0; transform: scale(0.85); }
    to   { opacity: 1; transform: scale(1); }
  }
  .strip-swatch:focus-visible {
    outline: 2px solid var(--white);
    outline-offset: -3px;
    z-index: 2;
  }

  @keyframes stripIn {
    to { opacity: 1; transform: translateY(0); }
  }

  .strip-info {
    position: absolute;
    inset: auto 0 0 0;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: linear-gradient(to top, rgba(0,0,0,.45) 0%, transparent 100%);
    transform: translateY(100%);
    transition: transform .22s ease;
    pointer-events: none;
  }
  .strip-swatch:hover .strip-info,
  .strip-swatch:focus-visible .strip-info { transform: translateY(0); }

  .strip-name {
    font-size: 12px;
    font-weight: 700;
    color: var(--white);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .strip-hex {
    font-family: "DM Mono", "Courier New", monospace;
    font-size: 10px;
    color: rgba(255,255,255,.75);
  }

  /* Hero body */
  .hero-body {
    max-width: 1320px;
    margin: 0 auto;
    padding: 40px 24px 48px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 48px;
    align-items: start;
  }

  /* ── Left column ─────────────────────────────────────────────────────── */
  .palette-chips {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .palette-chip {
    font-size: 11px;
    font-weight: 600;
    text-transform: capitalize;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--light);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    letter-spacing: .03em;
  }
  .palette-chip--mood {
    background: color-mix(in srgb, var(--orange) 10%, transparent);
    border-color: color-mix(in srgb, var(--orange) 25%, transparent);
    color: var(--orange);
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .hero-title {
    font-family: "Caveat", cursive, sans-serif;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -.03em;
    line-height: 1.0;
    color: var(--text-primary);
    margin-bottom: 14px;
  }
  .hero-desc {
    font-size: 15px;
    line-height: 1.75;
    color: var(--text-secondary);
    max-width: 540px;
    margin-bottom: 28px;
  }

  .hero-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 20px;
    background: var(--orange);
    color: var(--white);
    border: none;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background .15s, transform .15s, box-shadow .15s;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--orange) 35%, transparent);
  }
  .btn-primary:hover {
    background: var(--orange-hover);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px color-mix(in srgb, var(--orange) 35%, transparent);
  }
  .btn-primary:active { transform: translateY(0); }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 20px;
    background: var(--white);
    color: var(--text-primary);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: border-color .15s, color .15s, transform .15s;
  }
  .btn-secondary:hover {
    border-color: var(--orange);
    color: var(--orange);
    transform: translateY(-1px);
  }

  .hero-stats {
