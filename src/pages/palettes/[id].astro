  }

  /* ── Usage section ──────────────────────────────────────────────────── */
  .usage-section {
    padding: 48px 0;
    border-bottom: 1px solid var(--border);
  }

  /* Three-column grid that gracefully collapses */
  .usage-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 16px;
    align-items: start;
  }

  .usage-card {
    background: var(--white);
    border: 1px solid var(--border);
