  }
  .pnav-link--next:hover { transform: translateX(3px); }
  .pnav-link:focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; }

  .pnav-dots { display: flex; gap: 5px; flex-shrink: 0; }
  .pnav-dot  {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    box-shadow: var(--shadow-sm);
    flex-shrink: 0;
    transition: transform .2s;
