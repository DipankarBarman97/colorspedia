    background: var(--white);
    transition: transform .2s var(--ease-spring), box-shadow .2s, border-color .2s;
  }
  .family-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: color-mix(in srgb, var(--fc) 40%, transparent);
