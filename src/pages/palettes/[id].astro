  .family-count { font-size: 12px; color: var(--text-muted); font-weight: 500; }
  .family-arrow {
    font-size: 13px;
    color: var(--text-muted);
    transition: transform .15s, color .15s;
  }
  .family-card:hover .family-arrow { transform: translateX(4px); color: var(--orange); }

  /* ── Related palettes ───────────────────────────────────────────────── */
  .related-section {
    padding: 48px 0;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .related-section .section-title { margin-bottom: 24px; }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
