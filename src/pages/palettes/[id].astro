</style>

<script>
  // ── Helpers ────────────────────────────────────────────────────────────────
  const toast = document.getElementById("toast")!;
  let toastTimer: ReturnType<typeof setTimeout>;

  function showToast(msg: string) {
    toast.textContent = msg;
    toast.classList.add("toast--visible");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove("toast--visible"), 1800);
  }

  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.style.cssText = "position:fixed;opacity:0;top:0;left:0";
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand("copy");
      document.body.removeChild(ta);
      return ok;
    }
  }

  function setButtonCopied(btn: HTMLButtonElement, duration = 1800) {
    const original = btn.innerHTML;
    btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Copied!`;
    btn.disabled = true;
    btn.style.opacity = "0.85";
    setTimeout(() => {
      btn.innerHTML = original;
      btn.disabled = false;
      btn.style.opacity = "";
    }, duration);
  }

  // ── Strip swatches ─────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>(".strip-swatch").forEach((el) => {
    el.addEventListener("click", async () => {
      const hex = el.dataset.hex || "";
      if (await copyText(hex)) {
        el.classList.add("copied");
        showToast(hex);
        setTimeout(() => el.classList.remove("copied"), 1200);
      }
    });
  });

  // ── Sidebar swatch column ──────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>(".swatch-row-btn").forEach((el) => {
    el.addEventListener("click", async () => {
      const hex = el.dataset.hex || "";
      if (await copyText(hex)) showToast(hex);
    });
  });

  // ── Format toggle ──────────────────────────────────────────────────────────
  let activeFmt = "hex";

  document.querySelectorAll<HTMLButtonElement>(".fmt-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      activeFmt = btn.dataset.fmt || "hex";
      document.querySelectorAll<HTMLButtonElement>(".fmt-btn").forEach((b) => {
        b.classList.toggle("fmt-btn--active", b === btn);
      });
      document.querySelectorAll<HTMLElement>(".val-hex, .val-rgb, .val-hsl")
        .forEach((el) => {
          el.hidden = !el.classList.contains(`val-${activeFmt}`);
        });
    });
  });

  // ── Colour cards ───────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>(".color-card").forEach((card) => {
    card.addEventListener("click", async () => {
      const val =
        activeFmt === "hex" ? card.dataset.hex :
        activeFmt === "rgb" ? card.dataset.rgb :
                              card.dataset.hsl;
      if (!val) return;
      if (await copyText(val)) {
        card.classList.add("copied");
        showToast(val);
        setTimeout(() => card.classList.remove("copied"), 1200);
      }
    });
  });

  // ── Copy all hex ───────────────────────────────────────────────────────────
  const copyAllBtn = document.getElementById("copy-all-btn") as HTMLButtonElement | null;
  copyAllBtn?.addEventListener("click", async () => {
    const hexes = (copyAllBtn.dataset.hexes || "").split(",").join(", ");
    if (await copyText(hexes)) {
      setButtonCopied(copyAllBtn);
      showToast("All hex codes copied!");
    }
  });

  // ── Copy CSS variables (header button) ────────────────────────────────────
  const copyCssVarsBtn = document.getElementById("copy-css-vars-btn") as HTMLButtonElement | null;
  copyCssVarsBtn?.addEventListener("click", async () => {
    const code = document.getElementById("css-code-content")?.textContent || "";
    if (await copyText(code)) {
      setButtonCopied(copyCssVarsBtn);
      showToast("CSS variables copied!");
    }
  });

  // ── Copy CSS variables (card button) ──────────────────────────────────────
  const snippetBtn = document.getElementById("copy-snippet-btn") as HTMLButtonElement | null;
  snippetBtn?.addEventListener("click", async () => {
    const code = document.getElementById("css-code-content")?.textContent || "";
    if (await copyText(code)) {
      setButtonCopied(snippetBtn);
      showToast("CSS variables copied!");
    }
  });
</script>