  }
  .hero-stat-label {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--text-muted);
  }

  /* ── Right column — swatch sidebar ──────────────────────────────────── */
  .hero-right {
    flex-shrink: 0;
  }
  .swatch-column {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 164px;
  }
  .swatch-row-btn {
    width: 100%;
    height: 48px;
    border-radius: 10px;
