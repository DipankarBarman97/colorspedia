---
// src/components/Loader.astro
// Full-page transition loader — shown on initial load, fades out once the page is ready.
// Usage: drop <Loader /> anywhere inside <body> in your Layout.astro
---

<div class="loader" id="site-loader" aria-hidden="true" role="presentation">
  <div class="loader-inner">
    <div class="loader-dots">
      <span class="dot" style="--c:#ef4444; --d:0ms"></span>
      <span class="dot" style="--c:#f97316; --d:80ms"></span>
      <span class="dot" style="--c:#eab308; --d:160ms"></span>
      <span class="dot" style="--c:#22c55e; --d:240ms"></span>
      <span class="dot" style="--c:#3b82f6; --d:320ms"></span>
      <span class="dot" style="--c:#a855f7; --d:400ms"></span>
    </div>
    <span class="loader-wordmark">ColorsPedia</span>
  </div>
</div>

<script>
  const loader = document.getElementById("site-loader");

  function hide() {
    if (!loader) return;
    loader.classList.add("loader--hidden");
    // Remove from DOM after transition completes so it doesn't block interaction
    loader.addEventListener("transitionend", () => loader.remove(), {
      once: true,
    });
  }

  if (document.readyState === "complete") {
    // Already loaded (e.g. cached page)
    setTimeout(hide, 4);
  } else {
    window.addEventListener("load", () => setTimeout(hide, 4));
  }

  // Safety fallback — never show longer than 3s
  setTimeout(hide, 4);
</script>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--bg, #faf9f7);
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      opacity 0.45s ease,
      visibility 0.45s ease;
  }

  .loader--hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .loader-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  /* Dot grid */
  .loader-dots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--c);
    animation: dotPulse 1.1s ease-in-out infinite;
    animation-delay: var(--d);
    transform-origin: center;
  }

  @keyframes dotPulse {
    0%,
    100% {
      transform: scale(0.6);
      opacity: 0.35;
    }
    50% {
      transform: scale(1);
      opacity: 1;
    }
  }

  /* Wordmark */
  .loader-wordmark {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-primary, #1a1a1a);
    opacity: 0.35;
    animation: wordFade 1.4s ease-in-out infinite;
  }

  @keyframes wordFade {
    0%,
    100% {
      opacity: 0.25;
    }
    50% {
      opacity: 0.55;
    }
  }
</style>
