---
import type { ColorFamily } from "../data/colors";
import { getTextColor } from "../data/colors";

interface Props {
  color: ColorFamily;
  index: number;
}

const { color, index } = Astro.props;
const textColor = getTextColor(color.baseHex);
---

<a
  href={`/colors/${color.slug}`}
  class="color-card"
  style={`--card-color: ${color.baseHex}; --card-text: ${textColor}; animation-delay: ${index * 0.04}s`}
  aria-label={`Explore ${color.name} shades`}
>
  <!-- Shade Strip Preview -->
  <div class="shade-strip-row">
    {
      color.shades?.map((shade) => (
        <div
          class="shade-strip"
          style={`background: ${shade.hex}`}
          title={shade.name}
        />
      ))
    }
  </div>

  <!-- Main color swatch -->
  <div class="card-swatch" style={`background: ${color.baseHex}`}>
    <div class="card-swatch-inner">
      <span class="card-name" style={`color: ${textColor}`}>{color.name}</span>
      <span class="card-hex" style={`color: ${textColor}; opacity: 0.75`}
        >{color.baseHex}</span
      >
    </div>
    <div class="card-count" style={`color: ${textColor}; opacity: 0.6`}>
      {color.shades.length} shades
    </div>
  </div>

  <!-- Tags -->
  <div class="card-tags">
    {color.tags.slice(0, 2)?.map((tag) => <span class="card-tag">{tag}</span>)}
  </div>
</a>

<style>
  .color-card {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--white);
    border: 1px solid var(--border-subtle);
    text-decoration: none;
    cursor: pointer;
    opacity: 0;
    animation: fadeInUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    transition:
      transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .color-card:hover {
    transform: translateY(-6px) scale(1.015);
    box-shadow:
      0 20px 48px -8px color-mix(in srgb, var(--card-color) 30%, transparent),
      0 8px 16px -4px rgba(0, 0, 0, 0.1);
    border-color: color-mix(in srgb, var(--card-color) 40%, transparent);
  }

  .shade-strip-row {
    display: flex;
    height: 8px;
    overflow: hidden;
  }

  .shade-strip {
    flex: 1;
    transition: flex 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .color-card:hover .shade-strip:hover {
    flex: 3;
  }

  .card-swatch {
    padding: 20px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-height: 110px;
    justify-content: space-between;
  }

  .card-swatch-inner {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .card-name {
    
    font-size: 18px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.02em;
  }

  .card-hex {
    font-family: "DM Mono", "Courier New", monospace;
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  .card-count {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .card-tags {
    padding: 10px 14px;
    display: flex;
    gap: 6px;
    border-top: 1px solid var(--border-subtle);
    background: var(--white);
  }

  .card-tag {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    background: var(--light);
    border: 1px solid var(--border-subtle);
    padding: 2px 8px;
    border-radius: 999px;
    letter-spacing: 0.02em;
    transition: all 0.15s ease;
  }

  .color-card:hover .card-tag {
    background: color-mix(in srgb, var(--card-color) 10%, transparent);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
