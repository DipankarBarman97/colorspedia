---
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/palettes", label: "Palettes" },
  { href: "/about", label: "About" },
];

const currentPath = Astro.url.pathname;
---

<header class="header-root">
  <div class="header-inner">
    <!-- Logo -->
    <a href="/" class="logo-link" aria-label="Colorspedia Home">
      <div class="logo-icon">
        <div class="logo-dot" style="background:#ef4444"></div>
        <div class="logo-dot" style="background:#f97316"></div>
        <div class="logo-dot" style="background:#eab308"></div>
        <div class="logo-dot" style="background:#22c55e"></div>
        <div class="logo-dot" style="background:#3b82f6"></div>
        <div class="logo-dot" style="background:#a855f7"></div>
      </div>
      <span class="logo-text">ColorsPedia</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="nav" aria-label="Main navigation">
      {
        navLinks?.map((link) => (
          <a
            href={link.href}
            class={`nav-link ${currentPath === link.href ? "nav-link--active" : ""}`}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Mobile hamburger -->
    <button
      class="hamburger"
      id="hamburger"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 640 640"
        width="18"
        height="18"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M96 160C96 142.3 110.3 128 128 128L512 128C529.7 128 544 142.3 544 160C544 177.7 529.7 192 512 192L128 192C110.3 192 96 177.7 96 160zM96 320C96 302.3 110.3 288 128 288L512 288C529.7 288 544 302.3 544 320C544 337.7 529.7 352 512 352L128 352C110.3 352 96 337.7 96 320zM544 480C544 497.7 529.7 512 512 512L128 512C110.3 512 96 497.7 96 480C96 462.3 110.3 448 128 448L512 448C529.7 448 544 462.3 544 480z"
        ></path>
      </svg>
    </button>
  </div>

  <!-- Mobile dropdown — absolutely positioned, not in flow -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav class="mobile-nav" aria-label="Mobile navigation">
      {
        navLinks?.map((link) => (
          <a
            href={link.href}
            class={`mobile-nav-link ${currentPath === link.href ? "mobile-nav-link--active" : ""}`}
          >
            {link.label}
            {currentPath === link.href && (
              <span class="mobile-nav-dot" aria-hidden="true" />
            )}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .header-root {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--border-subtle);
    /* Needed so the absolute dropdown is anchored here */
    isolation: isolate;
  }

  .header-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 24px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  /* ── Desktop nav ─────────────────────────────────────────────────────── */
  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link {
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .nav-link:hover {
    color: var(--orange-hover);
    background: var(--surface-hover);
  }
  .nav-link--active {
    color: var(--orange);
    background: var(--orange-subtle);
  }

  /* ── Hamburger ───────────────────────────────────────────────────────── */
  .hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1.5px solid var(--border);
    border-radius: 8px;
    background: var(--white);
    color: var(--text-secondary);
    cursor: pointer;
    flex-shrink: 0;
    transition:
      border-color 0.15s,
      background 0.15s,
      color 0.15s;
  }
  .hamburger:hover {
    border-color: var(--orange);
    background: var(--surface-hover);
    color: var(--orange);
  }
  .hamburger[aria-expanded="true"] {
    border-color: var(--orange);
    background: color-mix(in srgb, var(--orange) 8%, var(--white));
    color: var(--orange);
  }

  /* ── Mobile dropdown — true dropdown, out of flow ────────────────────── */
  .mobile-menu {
    display: none; /* toggled to block via JS */
    position: absolute;
    top: calc(100% + 6px);
    right: 16px;
    width: 220px;
    background: var(--white);
    border: 1.5px solid var(--border);
    border-radius: 16px;
    box-shadow:
      0 16px 48px rgba(0, 0, 0, 0.12),
      0 4px 16px rgba(0, 0, 0, 0.06);
    z-index: 200;
    overflow: hidden;
    transform-origin: top center;
    animation: menuDrop 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes menuDrop {
    from {
      opacity: 0;
      transform: scale(0.97) translateY(-6px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    padding: 8px;
    gap: 2px;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 14px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition:
      background 0.15s,
      color 0.15s;
  }
  .mobile-nav-link:hover {
    background: var(--surface-hover);
    color: var(--orange);
  }
  .mobile-nav-link--active {
    color: var(--orange);
    background: var(--orange-subtle);
    font-weight: 600;
  }

  .mobile-nav-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--orange);
    flex-shrink: 0;
  }

  /* ── Responsive ──────────────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .header-inner {
      padding: 0 16px;
      gap: 16px;
    }
    .nav {
      display: none;
    }
    .hamburger {
      display: flex;
    }
  }
</style>

<script>
  const hamburger = document.getElementById("hamburger")!;
  const mobileMenu = document.getElementById("mobile-menu")!;

  function openMenu() {
    hamburger.setAttribute("aria-expanded", "true");
    mobileMenu.setAttribute("aria-hidden", "false");
    mobileMenu.style.display = "block";
  }

  function closeMenu() {
    hamburger.setAttribute("aria-expanded", "false");
    mobileMenu.setAttribute("aria-hidden", "true");
    mobileMenu.style.display = "none";
  }

  hamburger.addEventListener("click", (e) => {
    e.stopPropagation();
    const isOpen = hamburger.getAttribute("aria-expanded") === "true";
    isOpen ? closeMenu() : openMenu();
  });

  // Close on outside click
  document.addEventListener("click", (e) => {
    if (
      !hamburger.contains(e.target as Node) &&
      !mobileMenu.contains(e.target as Node)
    ) {
      closeMenu();
    }
  });

  // Close on Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });

  // Close on nav link click
  mobileMenu.querySelectorAll(".mobile-nav-link").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });
</script>
